---
import { SITE } from '../consts';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InkCursor from '../components/InkCursor.astro';
import SmallTags from '../components/SmallTags.astro';
import { getCollection } from 'astro:content';
import { tagCounts, visiblePosts } from '../utils/posts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
}

const { title, description = SITE.description, type = 'website', publishedAt } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(SITE.ogImage, site).href;

const isArticle = type === 'article';
const siteTags = isArticle ? tagCounts(visiblePosts(await getCollection('writeups'))) : [];

/** 结构化数据：JSON 里的 `<` 转义成 \\u003c，避免正文出现 </script> 时把标签顶断 */
const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');

/** 站点级结构化数据：让搜索引擎知道这是一个带作者的技术博客 */
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: site.href,
  description: SITE.description,
  inLanguage: 'zh-CN',
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.github,
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#ece5d6" />
    <!-- 先于样式表铺纸色：iOS Safari 跨页时会先给一帧空白，别让它白闪 -->
    <style is:inline>
      html,
      body {
        background: #ece5d6;
        color-scheme: light;
      }
    </style>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <!-- 标题用行楷（霞鹜文楷，OFL 开源，自托管分片按需加载） -->
    <!-- 站内实际只用 110、113–119 这几片，提前预加载，避免换页时标题先正楷再跳行楷 -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-110.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-113.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-114.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-115.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-116.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-117.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-118.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/wenkai/files/lxgwwenkai-regular-subset-119.woff2" />
    <link rel="stylesheet" href="/fonts/wenkai/lxgwwenkai-regular.css" />

    <script type="application/ld+json" set:html={jsonLd(siteSchema)} />
    {Astro.url.pathname === '/' && (
      <script is:inline>
        document.documentElement.classList.add('intro-on');
      </script>
    )}
    <slot name="head" />
  </head>
  <body id="top">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {isArticle && <SmallTags tags={siteTags} />}
    <InkCursor />

    <script is:inline>
      // Ctrl/Cmd+K 或 / 直接跳到搜索页，省一次鼠标
      document.addEventListener('keydown', function (e) {
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
        if (typing) return;
        if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
          e.preventDefault();
          if (!location.pathname.startsWith('/search')) location.href = '/search/?focus=1';
        } else if (e.key === '/' && !location.pathname.startsWith('/search')) {
          e.preventDefault();
          location.href = '/search/?focus=1';
        }
      });
    </script>
  </body>
</html>
