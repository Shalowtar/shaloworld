---
interface Segment {
  label: string;
  href?: string;
  /** 分类名传进来后按分类配色上色 */
  cat?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

<p class="breadcrumb">
  <a href="/">~</a>{segments.map((s) => (<><span class="sep">/</span>{s.href ? <>{' '}<a href={s.href} class={s.cat ? 'crumb-link cat-tone' : 'crumb-link'} data-cat={s.cat}>{s.label}</a></> : <span class={s.cat ? 'cat-tone' : undefined} data-cat={s.cat}>{s.label}</span>}</>))}
</p>
