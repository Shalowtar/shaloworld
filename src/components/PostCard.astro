---
import type { Post } from '../utils/posts';
import { formatDate, readingTime } from '../utils/posts';

interface Props {
  post: Post;
  showSummary?: boolean;
}

const { post, showSummary = true } = Astro.props;
const { title, summary, category, difficulty, event, tags, publishedAt } = post.data;
const href = `/writeups/${post.id}/`;
---

<article class="entry">
  <a class="entry-main" href={href} aria-label={title}>
    <div class="entry-kicker">
      <span class="k-cat" data-cat={category}>{category}</span>
      {
        difficulty && (
          <>
            <span class="k-sep">·</span>
            <span>{difficulty}</span>
          </>
        )
      }
      {
        event && (
          <>
            <span class="k-sep">·</span>
            <span>{event}</span>
          </>
        )
      }
    </div>
    <h3>{title}</h3>
    {showSummary && <p>{summary}</p>}
  </a>
  <aside class="entry-side">
    <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
    <span>{readingTime(post.body)} min</span>
    {tags.slice(0, 2).map((t) => <span class="tag">{t}</span>)}
  </aside>
</article>
