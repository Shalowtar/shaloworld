---
import { formatDate } from '../utils/posts';

export interface DirPostData {
  id: string;
  title: string;
  date: Date;
  subcategories: string[];
}

interface Props {
  post: DirPostData;
}

const { post } = Astro.props;
---

<article class="dir-post">
  <a class="dir-post-head is-link" href={`/writeups/${post.id}/`}>
    <span class="dir-post-title">{post.title}</span>
    <time class="dir-date" datetime={post.date.toISOString()}>
      {formatDate(post.date)}
    </time>
  </a>
</article>
