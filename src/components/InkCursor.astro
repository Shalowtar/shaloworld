<canvas class="ink-canvas" aria-hidden="true"></canvas>
<canvas class="ink-hover" aria-hidden="true"></canvas>
<span class="ink-rest" aria-hidden="true"><i></i></span>

<script is:inline>
  (function () {
    var fine = window.matchMedia('(pointer: fine)').matches;
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || calm) return;

    var trailCanvas = document.querySelector('.ink-canvas');
    var ringCanvas = document.querySelector('.ink-hover');
    var rest = document.querySelector('.ink-rest');
    if (!trailCanvas || !ringCanvas) return;
    var tctx = trailCanvas.getContext('2d');
    var rctx = ringCanvas.getContext('2d');
    if (!tctx || !rctx) return;

    var INK = '148, 55, 38'; // 朱砂，与之前粒子同色
    var STEP = 3; // 补点间距，越小笔迹越连贯
    var RING_SPEED = 85; // 悬停墨笔沿描边走的速度（像素/秒），所有框一致

    var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    var W = 0;
    var H = 0;

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      var list = [trailCanvas, ringCanvas];
      for (var i = 0; i < list.length; i += 1) {
        list[i].width = Math.round(W * dpr);
        list[i].height = Math.round(H * dpr);
        list[i].style.width = W + 'px';
        list[i].style.height = H + 'px';
      }
      tctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      rctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    var running = false;
    var lastFrame = 0;
    var hoverEl = null;
    var hoverRect = null;
    var hoverPoints = [];
    var hoverPointsSig = '';
    var hoverLen = 1;
    var hoverStart = 0; // 起笔位置（沿描边的弧长，取离指针最近处）
    var pointerX = 0;
    var pointerY = 0;
    var hoverDir = 1;
    var hoverSince = 0;
    var hoverLeaveAt = 0;
    var hoverKey = null;

    function clamp(v, lo, hi) {
      return v < lo ? lo : v > hi ? hi : v;
    }

    /** 预先烘焙墨点贴图：中心实、外圈一层层洇开 */
    function makeDab(stops) {
      var s = document.createElement('canvas');
      s.width = 64;
      s.height = 64;
      var c = s.getContext('2d');
      var g = c.createRadialGradient(32, 32, 0, 32, 32, 32);
      for (var i = 0; i < stops.length; i += 1) {
        g.addColorStop(stops[i][0], 'rgba(' + INK + ',' + stops[i][1] + ')');
      }
      c.fillStyle = g;
      c.beginPath();
      c.arc(32, 32, 32, 0, Math.PI * 2, false);
      c.fill();
      return s;
    }
    var trailDab = makeDab([
      [0, 0.7],
      [0.16, 0.52],
      [0.36, 0.3],
      [0.58, 0.14],
      [0.8, 0.05],
      [1, 0],
    ]);
    var ringDab = makeDab([
      [0, 0.86],
      [0.2, 0.5],
      [0.45, 0.22],
      [0.7, 0.08],
      [1, 0],
    ]);

    // 静止时的墨：指针停下 240ms 后，落点那团湿墨开始呼吸（CSS 动画负责扩散，这里只管摆位和显隐）
    var idleTimer = 0;
    function placeRest(x, y) {
      if (!rest) return;
      rest.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
    }
    function restIdle() {
      if (!rest) return;
      rest.classList.remove('is-gone');
      rest.classList.add('is-idle');
    }
    function restWake() {
      if (!rest) return;
      if (idleTimer) {
        clearTimeout(idleTimer);
        idleTimer = 0;
      }
      rest.classList.remove('is-idle');
      rest.classList.remove('is-gone');
    }
    function restHide() {
      if (!rest) return;
      if (idleTimer) {
        clearTimeout(idleTimer);
        idleTimer = 0;
      }
      rest.classList.remove('is-idle');
      rest.classList.add('is-gone');
    }
    function restSchedule() {
      if (!rest) return;
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(restIdle, 240);
    }
    function restHot(on) {
      if (!rest) return;
      if (on) rest.classList.add('is-hot');
      else rest.classList.remove('is-hot');
    }

    /**
     * 尾迹：把指针路径记成一串点，每帧用墨点把它们重新叠出来 ——
     * 墨点之间互相压着，所以不会像逐段描线那样露出空当；
     * 每个点的浓淡和粗细按它的年龄算，指针处最浓，越往后越淡越细，最后化掉。
     */
    var TRAIL_LIFE = 1600; // 尾迹从浓到化掉的总时长（毫秒）
    var lastX = null;
    var lastY = null;
    var lastAt = 0;
    var stampSpeed = 0.2;
    var lastStampAt = 0;
    var pts = [];
    var clicks = []; // 点击时凝聚又散开的墨圈
    var CLICK_LIFE = 1000;
    var bloomAcc = 0; // 拖动时累计走过的距离，够一段就洇一团小墨

    function pushPoint(x, y, t, v) {
      pts.push({ x: x, y: y, t: t, v: v });
      while (pts.length > 300) pts.shift();
    }

    function inkTo(x, y, now) {
      if (lastX === null) {
        lastX = x;
        lastY = y;
        lastAt = now;
        lastStampAt = now;
        pushPoint(x, y, now, 0.3);
        return;
      }

      var dx = x - lastX;
      var dy = y - lastY;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 0.7) {
        lastAt = now;
        return;
      }

      var dt = Math.max(1, now - lastAt);
      stampSpeed = stampSpeed * 0.55 + (dist / dt) * 0.45;

      // 补点：事件之间不管跨多远都按 3px 铺满，快速甩动也连成整笔
      var n = Math.min(600, Math.ceil(dist / STEP));
      for (var i = 1; i <= n; i += 1) {
        var f = i / n;
        pushPoint(lastX + dx * f, lastY + dy * f, lastAt + dt * f, stampSpeed);
      }

      // 每走一小段，就在笔路上洇开一团小墨（和点击同一个动作，小一号）
      bloomAcc += dist;
      if (bloomAcc >= 36) {
        bloomAcc = 0;
        addBloom(x, y, now);
      }

      lastX = x;
      lastY = y;
      lastAt = now;
      lastStampAt = now;
    }

    // 指针离开窗口 / 跨进 iframe 时断开笔路，免得回来时画出一条横贯屏幕的直线
    function liftPen() {
      lastX = null;
      lastY = null;
      lastAt = 0;
      pts.length = 0;
    }

    /** 点击：一圈墨点先向中心聚拢凝成一小团，随后整圈向外散开淡去 */
    function addClick(x, y, now) {
      spawn(x, y, now, 1, CLICK_LIFE, 1);
    }

    /** 拖动时沿笔路洇开的小墨团：同一套凝聚又散开的动作，只是小一号、慢一点 */
    function addBloom(x, y, now) {
      spawn(x, y, now, 0.58, 780, 0.8);
    }

    function spawn(x, y, now, k, life, mul) {
      clicks.push({
        x: x,
        y: y,
        t: now,
        seed: Math.random() * Math.PI * 2,
        k: k,
        life: life,
        mul: mul,
      });
      while (clicks.length > 12) clicks.shift();
      ensureLoop();
    }

    function drawClicks(now) {
      if (!clicks.length) return;

      for (var i = clicks.length - 1; i >= 0; i -= 1) {
        if (now - clicks[i].t > clicks[i].life) clicks.splice(i, 1);
      }

      for (var i = 0; i < clicks.length; i += 1) {
        var c = clicks[i];
        var age = now - c.t;
        if (age < 0 || age > c.life) continue;

        var k = c.k;
        var inP = clamp(age / 260, 0, 1); // 凝聚段
        var outP = clamp((age - 260) / (c.life - 260), 0, 1); // 散开段

        // 半径：从 30px 收成 8px 凝成一团，再向外推到 56px 散开
        var rr = (30 - 22 * inP + 48 * outP * outP) * k;
        var alpha = Math.pow(inP, 1.2) * Math.pow(1 - outP, 1.3) * c.mul;
        if (alpha <= 0.03) continue;

        // 散开时墨点本身也放大，像墨在纸上化开
        var dab = (5.4 * (1 - 0.2 * inP) + 10 * outP) * k;
        var rot = c.seed + (age / 1000) * 0.8;
        var n = k < 0.6 ? 11 : 16;

        for (var j = 0; j < n; j += 1) {
          var a = rot + (j / n) * Math.PI * 2;
          var dx = c.x + Math.cos(a) * rr;
          var dy = c.y + Math.sin(a) * rr;
          tctx.globalAlpha = clamp(alpha * 0.42, 0, 1);
          tctx.drawImage(ringDab, dx - dab, dy - dab, dab * 2, dab * 2);
        }

        // 中心一点更实的墨核
        var core = (9 - 4.5 * inP) * k;
        tctx.globalAlpha = clamp(alpha * 0.5, 0, 1);
        tctx.drawImage(ringDab, c.x - core, c.y - core, core * 2, core * 2);
      }

      tctx.globalAlpha = 1;
    }

    /** 逐点重绘尾迹：贴图半径比笔宽大一圈，让晕开的边缘自然叠在一起 */
    function drawTrail(now) {
      tctx.clearRect(0, 0, W, H);
      drawClicks(now);
      if (!pts.length) return;

      for (var i = 0; i < pts.length; i += 1) {
        var p = pts[i];
        var age = clamp((now - p.t) / TRAIL_LIFE, 0, 1);
        var k = Math.pow(1 - age, 1.4); // 头部浓、尾部淡
        if (k <= 0.02) continue;

        // 笔宽随速度收、随年龄变细：尾巴自然收成一条细墨；贴图半径放大，让晕边互相压住
        var hw = clamp(3.0 - p.v * 0.55, 1.9, 3.0) * (0.4 + 0.6 * k);
        var r = hw * 2.6;

        // 离指针越近越浓：鼠标脚下这一小段最深，越往后越淡
        var prox = 1;
        if (lastX !== null) {
          var gx = p.x - lastX;
          var gy = p.y - lastY;
          prox = clamp(1 - Math.sqrt(gx * gx + gy * gy) / 150, 0, 1);
        }
        var a = 0.22 * k * (0.72 + 0.3 * prox);

        tctx.globalAlpha = a;
        tctx.drawImage(trailDab, p.x - r, p.y - r, r * 2, r * 2);
      }

      // 笔尖：指针正下方压一小团更深的湿墨
      var headAge = clamp((now - lastStampAt) / 620, 0, 1);
      var hk = Math.pow(1 - headAge, 1.5);
      if (hk > 0.03) {
        var hr = 10 * (0.7 + 0.3 * hk);
        tctx.globalAlpha = 0.24 * hk;
        tctx.drawImage(trailDab, (lastX === null ? 0 : lastX) - hr, (lastY === null ? 0 : lastY) - hr, hr * 2, hr * 2);
      }

      tctx.globalAlpha = 1;
    }

    /** 圆角矩形的轮廓采样点（顺时针，起点在左上角之后） */
    function roundRectPoints(rect, step) {
      var rad = Math.min(14, Math.min(rect.width, rect.height) / 2);
      var pts = [];
      var L = rect.left;
      var T = rect.top;
      var R = rect.left + rect.width;
      var B = rect.top + rect.height;

      function line(x1, y1, x2, y2) {
        var d = Math.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
        var n = Math.max(1, Math.ceil(d / step));
        for (var i = 1; i <= n; i += 1) pts.push([x1 + (x2 - x1) * (i / n), y1 + (y2 - y1) * (i / n)]);
      }
      function arc(cx, cy, a0, a1) {
        var n = Math.max(2, Math.ceil((rad * Math.abs(a1 - a0)) / step));
        for (var i = 1; i <= n; i += 1) {
          var a = a0 + (a1 - a0) * (i / n);
          pts.push([cx + Math.cos(a) * rad, cy + Math.sin(a) * rad]);
        }
      }

      pts.push([L + rad, T]);
      line(L + rad, T, R - rad, T);
      arc(R - rad, T + rad, -Math.PI / 2, 0);
      line(R, T + rad, R, B - rad);
      arc(R - rad, B - rad, 0, Math.PI / 2);
      line(R - rad, B, L + rad, B);
      arc(L + rad, B - rad, Math.PI / 2, Math.PI);
      line(L, B - rad, L, T + rad);
      arc(L + rad, T + rad, Math.PI, Math.PI * 1.5);
      return pts;
    }

    /** 沿采样点累加周长，用来把“每秒多少像素”换算成绕圈位置 */
    function perimeterLen(list) {
      var s = 0;
      for (var i = 1; i < list.length; i += 1) {
        var dx = list[i][0] - list[i - 1][0];
        var dy = list[i][1] - list[i - 1][1];
        s += Math.sqrt(dx * dx + dy * dy);
      }
      return s || 1;
    }

    /** 找到离指针最近的那一点，换算成沿描边的弧长，作为墨迹的起点 */
    function nearestArc(list, L, x, y) {
      var best = 0;
      var bestD = Infinity;
      for (var i = 0; i < list.length; i += 1) {
        var dx = list[i][0] - x;
        var dy = list[i][1] - y;
        var d = dx * dx + dy * dy;
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      }
      return (best / Math.max(1, list.length - 1)) * L;
    }

    /**
     * 悬停：一笔墨从离指针最近的位置起笔，沿描边流过去（方向随机）——
     * 头部最浓、后面拖着渐淡渐细的墨尾，每 2.5px 叠一个墨点，所以是连贯的一笔；
     * 速度按“每秒走多少像素”算，大框小框拖得一样快。
     * 指针离开后，墨点向外散开并淡去，像墨迹在纸上化掉。
     */
    function drawHover(now) {
      rctx.clearRect(0, 0, W, H);
      if (!hoverRect || !hoverPoints.length) return;

      // 进场：240ms 淡入
      var enter = hoverLeaveAt ? 1 : clamp((now - hoverSince) / 240, 0, 1);

      // 离场：620ms 内向外散开并淡掉
      var fade = 1;
      var spread = 0;
      if (hoverLeaveAt) {
        var p = clamp((now - hoverLeaveAt) / 720, 0, 1);
        fade = 1 - p;
        spread = p * 16;
      }
      var level = enter * fade;
      if (level < 0.02) return;

      var len = hoverPoints.length;
      var L = hoverLen;
      var t = (hoverLeaveAt || now) - hoverSince;
      var run = (t / 1000) * RING_SPEED; // 墨头自起笔以来走过多远
      var travelled = hoverStart + hoverDir * run;
      travelled = ((travelled % L) + L) % L;

      var TAIL = L * 0.9; // 墨尾绕满几乎整圈，只在墨头前方留一小段空当
      // 墨尾是这一笔“带出来"的：起笔时没有尾巴，走到哪尾巴才长到哪
      var tailNow = Math.min(TAIL, run);
      if (tailNow < 1.5) tailNow = 1.5;

      var STEP_D = 2.5;
      var count = Math.max(1, Math.round(tailNow / STEP_D));
      var cx = hoverRect.left + hoverRect.width / 2;
      var cy = hoverRect.top + hoverRect.height / 2;

      for (var i = 0; i <= count; i += 1) {
        var d = i * STEP_D;
        if (d > tailNow) d = tailNow;
        var w = d / tailNow; // 0 = 墨头，1 = 墨尾末端
        if (w >= 0.99) continue;
        var k = Math.pow(1 - w, 0.6); // 收得很缓，尾段才不会提前消失

        var pos = travelled - hoverDir * d;
        pos = ((pos % L) + L) % L;
        var idx = Math.min(len - 1, Math.floor((pos / L) * len));
        var pt = hoverPoints[idx];

        var px = pt[0];
        var py = pt[1];
        if (spread) {
          // 由框心朝外推开：散开时墨点向外飘、同时变大变淡
          var ox = px - cx;
          var oy = py - cy;
          var od = Math.sqrt(ox * ox + oy * oy) || 1;
          px += (ox / od) * spread;
          py += (oy / od) * spread;
        }

        var hw = 3.5 * (0.55 + 0.45 * k) + spread * 0.22;
        var r = hw * 2.6;

        rctx.globalAlpha = clamp(level * 0.22 * k, 0, 1);
        rctx.drawImage(ringDab, px - r, py - r, r * 2, r * 2);
      }

      // 头部一小团更浓的湿墨，让“笔锋”落在纸上有个实点
      var hi = Math.min(len - 1, Math.floor((travelled / L) * len));
      var hp = hoverPoints[hi];
      var hx = hp[0];
      var hy = hp[1];
      if (spread) {
        var hox = hx - cx;
        var hoy = hy - cy;
        var hod = Math.sqrt(hox * hox + hoy * hoy) || 1;
        hx += (hox / hod) * spread;
        hy += (hoy / hod) * spread;
      }
      var hr = 9.5 + spread * 0.3;
      rctx.globalAlpha = clamp(level * 0.2, 0, 1);
      rctx.drawImage(ringDab, hx - hr, hy - hr, hr * 2, hr * 2);

      rctx.globalAlpha = 1;
    }

    function frame() {
      var now = performance.now();

      // 围框散开淡尽后清掉
      if (hoverRect && hoverLeaveAt && now - hoverLeaveAt > 760) {
        hoverRect = null;
        hoverLeaveAt = 0;
      }

      // 淘汰已经化掉的点
      while (pts.length && now - pts[0].t > TRAIL_LIFE) pts.shift();

      drawTrail(now);
      drawHover(now);
      lastFrame = now;

      if (!hoverRect && !pts.length) {
        tctx.clearRect(0, 0, W, H);
        rctx.clearRect(0, 0, W, H);
        lastFrame = 0;
        running = false;
        return;
      }
      requestAnimationFrame(frame);
    }

    function ensureLoop() {
      if (running) return;
      running = true;
      lastFrame = 0;
      requestAnimationFrame(frame);
    }

    function hitTest(target) {
      if (!target || !target.closest) return null;
      if (target.closest('[data-no-ink]')) return null;
      return target.closest('a, button, input, select, textarea, .chip, .flag-btn, .lightbox');
    }

    function updateHover() {
      if (!hoverEl) {
        if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        return;
      }
      var r = hoverEl.getBoundingClientRect();
      if (r.width > 320 || r.height > 120 || r.width * r.height > 34000) {
        hoverEl = null;
        if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        return;
      }
      hoverRect = {
        left: r.left - 8,
        top: r.top - 8,
        width: r.width + 16,
        height: r.height + 16,
      };
      var sig = Math.round(hoverRect.left) + ',' + Math.round(hoverRect.top) + ',' + Math.round(hoverRect.width) + ',' + Math.round(hoverRect.height);
      if (hoverKey !== hoverEl) {
        hoverKey = hoverEl;
        hoverSince = performance.now();
        hoverLeaveAt = 0;
        hoverDir = Math.random() < 0.5 ? 1 : -1; // 顺时针或逆时针随机
        hoverPoints = roundRectPoints(hoverRect, 4);
        hoverLen = perimeterLen(hoverPoints);
        // 从鼠标靠得最近的那一点起笔
        hoverStart = nearestArc(hoverPoints, hoverLen, pointerX, pointerY);
        hoverPointsSig = sig;
      } else {
        hoverLeaveAt = 0;
        if (hoverPointsSig !== sig) {
          hoverPoints = roundRectPoints(hoverRect, 4);
          hoverLen = perimeterLen(hoverPoints);
          hoverPointsSig = sig;
        }
      }
    }

    document.addEventListener(
      'pointerdown',
      function (e) {
        if (e.button !== 0 && e.pointerType === 'mouse') return;
        addClick(e.clientX, e.clientY, performance.now());
      },
      { passive: true }
    );

    document.addEventListener(
      'mousemove',
      function (e) {
        var x = e.clientX;
        var y = e.clientY;
        var now = performance.now();

        if (x >= 0 && y >= 0 && x <= W && y <= H) inkTo(x, y, now);
        pointerX = x;
        pointerY = y;

        placeRest(x, y);
        restWake();
        restSchedule();

        hoverEl = hitTest(e.target);
        updateHover();
        restHot(!!hoverRect);
        ensureLoop();
      },
      { passive: true }
    );

    // 移到内嵌 PDF / iframe 上时父页面收不到 mousemove，笔路断开、墨迹自行淡去
    document.addEventListener(
      'mouseover',
      function (e) {
        if (e.target && e.target.tagName === 'IFRAME') {
          hoverEl = null;
          liftPen();
          restHide();
          if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        }
      },
      true
    );

    document.addEventListener('mouseleave', function () {
      hoverEl = null;
      liftPen();
      restHide();
      if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
    });

    window.addEventListener(
      'scroll',
      function () {
        if (hoverEl) updateHover();
      },
      { passive: true }
    );

    // 切走窗口（Alt+Tab、点其它应用）时断开笔路，并把落点的墨收掉
    window.addEventListener('blur', function () {
      liftPen();
      restHide();
    });

    window.addEventListener('resize', function () {
      resize();
      liftPen();
    });
  })();
</script>
