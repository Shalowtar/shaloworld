<canvas class="ink-canvas" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    var fine = window.matchMedia('(pointer: fine)').matches;
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || calm) return;

    var canvas = document.querySelector('.ink-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var INK = '148, 55, 38'; // var(--accent)
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = 0;
    var H = 0;

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    var lastX = null;
    var lastY = null;
    var lastStamp = 0;
    var running = false;
    var hoverRect = null;
    var hoverEl = null;

    /** 一枚软边墨点 */
    function stamp(x, y, r, a) {
      var g = ctx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, 'rgba(' + INK + ',' + a + ')');
      g.addColorStop(0.45, 'rgba(' + INK + ',' + a * 0.55 + ')');
      g.addColorStop(1, 'rgba(' + INK + ',0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2, false);
      ctx.fill();
    }

    /** 沿目标轮廓描一圈墨线 */
    function inkRect(rect, alpha, width) {
      var x = rect.left;
      var y = rect.top;
      var w = rect.width;
      var h = rect.height;
      var r = 13;
      ctx.beginPath();
      if (ctx.roundRect) {
        ctx.roundRect(x, y, w, h, r);
      } else {
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }
      ctx.lineWidth = width;
      ctx.strokeStyle = 'rgba(' + INK + ',' + alpha + ')';
      ctx.shadowColor = 'rgba(' + INK + ',' + alpha * 1.6 + ')';
      ctx.shadowBlur = 3;
      ctx.stroke();
      ctx.shadowBlur = 0;
    }

    function hitTest(target) {
      if (!target || !target.closest) return null;
      return target.closest('a, button, input, select, textarea, .chip, .flag-btn, .lightbox');
    }

    function updateHoverRect() {
      if (!hoverEl) {
        hoverRect = null;
        return;
      }
      var r = hoverEl.getBoundingClientRect();
      if (r.width > 320 || r.height > 120 || r.width * r.height > 34000) {
        hoverRect = null;
        return;
      }
      hoverRect = {
        left: r.left - 7,
        top: r.top - 7,
        right: r.right + 7,
        bottom: r.bottom + 7,
        width: r.width + 14,
        height: r.height + 14,
      };
    }

    function ensureLoop() {
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    }

    function frame() {
      var now = performance.now();
      var idle = now - lastStamp;
      var hovering = !!hoverRect;

      // 用 destination-out 缓慢擦除，模拟墨迹干涸
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0, 0, 0,' + (idle > 420 ? 0.085 : 0.03) + ')';
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'source-over';

      if (hovering) {
        inkRect(hoverRect, 0.035, 2);
      }

      if (!hovering && idle > 1400) {
        ctx.clearRect(0, 0, W, H);
        running = false;
        return;
      }
      requestAnimationFrame(frame);
    }

    document.addEventListener(
      'mousemove',
      function (e) {
        var x = e.clientX;
        var y = e.clientY;

        if (lastX === null) {
          lastX = x;
          lastY = y;
        }

        // 在两点之间按固定步长补点，快速甩动时线条不会断成珠
        var dx = x - lastX;
        var dy = y - lastY;
        var dist = Math.sqrt(dx * dx + dy * dy);
        var stepSize = 3.5;
        var steps = Math.min(48, Math.max(1, Math.round(dist / stepSize)));

        for (var s = 1; s <= steps; s += 1) {
          var t = s / steps;
          var px = lastX + dx * t;
          var py = lastY + dy * t;
          // 慢速时墨点更大更浓，快速时更细更淡
          var radius = 4.6 + Math.min(4, 14 / (dist + 6));
          var alpha = 0.05 + Math.min(0.05, 4 / (dist + 24));
          stamp(px, py, radius, alpha);
        }

        lastX = x;
        lastY = y;
        lastStamp = performance.now();

        hoverEl = hitTest(e.target);
        updateHoverRect();
        if (hoverRect) {
          // 悬停时立刻沿目标轮廓落一圈墨，随后由动画帧继续加深
          inkRect(hoverRect, 0.06, 2);
        }
        ensureLoop();
      },
      { passive: true }
    );

    document.addEventListener(
      'mousedown',
      function (e) {
        stamp(e.clientX, e.clientY, 12, 0.14);
        lastStamp = performance.now();
        ensureLoop();
      },
      { passive: true }
    );

    // 移到内嵌 PDF / iframe 时父页面收不到 mousemove，墨迹自然干涸
    document.addEventListener(
      'mouseover',
      function (e) {
        if (e.target && e.target.tagName === 'IFRAME') {
          hoverEl = null;
          hoverRect = null;
          lastStamp = performance.now() - 300;
        }
      },
      true
    );

    window.addEventListener('scroll', updateHoverRect, { passive: true });

    document.addEventListener('mouseleave', function () {
      hoverEl = null;
      hoverRect = null;
      lastStamp = performance.now() - 300;
    });

    window.addEventListener('resize', function () {
      resize();
      lastX = null;
      lastY = null;
    });
  })();
</script>
