<canvas class="ink-canvas" aria-hidden="true"></canvas>
<canvas class="ink-hover" aria-hidden="true"></canvas>
<span class="ink-rest" aria-hidden="true"></span>

<script is:inline>
  (function () {
    var fine = window.matchMedia('(pointer: fine)').matches;
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || calm) return;

    var trailCanvas = document.querySelector('.ink-canvas');
    var ringCanvas = document.querySelector('.ink-hover');
    var rest = document.querySelector('.ink-rest');
    if (!trailCanvas || !ringCanvas) return;
    var tctx = trailCanvas.getContext('2d');
    var rctx = ringCanvas.getContext('2d');
    if (!tctx || !rctx) return;

    var INK = '148, 55, 38'; // 朱砂，与之前粒子同色
    var DRY = 900; // 墨干的时间常数（毫秒）
    var STEP = 2.5; // 盖墨点间距，越小笔迹越连贯
    var IDLE_STOP = 2400; // 这么久没落墨就停掉动画循环

    var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    var W = 0;
    var H = 0;

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      var list = [trailCanvas, ringCanvas];
      for (var i = 0; i < list.length; i += 1) {
        list[i].width = Math.round(W * dpr);
        list[i].height = Math.round(H * dpr);
        list[i].style.width = W + 'px';
        list[i].style.height = H + 'px';
      }
      tctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      rctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    var running = false;
    var lastFrame = 0;
    var hoverEl = null;
    var hoverRect = null;
    var hoverPoints = [];
    var hoverPointsSig = '';
    var hoverDir = 1;
    var hoverSince = 0;
    var hoverLeaveAt = 0;
    var hoverKey = null;

    function clamp(v, lo, hi) {
      return v < lo ? lo : v > hi ? hi : v;
    }

    /** 预先烘焙墨点贴图：中心实、外圈一层层洇开 */
    function makeDab(stops) {
      var s = document.createElement('canvas');
      s.width = 64;
      s.height = 64;
      var c = s.getContext('2d');
      var g = c.createRadialGradient(32, 32, 0, 32, 32, 32);
      for (var i = 0; i < stops.length; i += 1) {
        g.addColorStop(stops[i][0], 'rgba(' + INK + ',' + stops[i][1] + ')');
      }
      c.fillStyle = g;
      c.beginPath();
      c.arc(32, 32, 32, 0, Math.PI * 2, false);
      c.fill();
      return s;
    }
    var trailDab = makeDab([
      [0, 0.66],
      [0.26, 0.44],
      [0.52, 0.22],
      [0.78, 0.07],
      [1, 0],
    ]);
    var ringDab = makeDab([
      [0, 0.9],
      [0.24, 0.52],
      [0.55, 0.18],
      [0.82, 0.05],
      [1, 0],
    ]);

    // 静止时的墨：指针停下 240ms 后，落点那团湿墨开始呼吸（CSS 动画负责扩散，这里只管摆位和显隐）
    var idleTimer = 0;
    function placeRest(x, y) {
      if (!rest) return;
      rest.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
    }
    function restIdle() {
      if (!rest) return;
      rest.classList.remove('is-gone');
      rest.classList.add('is-idle');
    }
    function restWake() {
      if (!rest) return;
      if (idleTimer) {
        clearTimeout(idleTimer);
        idleTimer = 0;
      }
      rest.classList.remove('is-idle');
      rest.classList.remove('is-gone');
    }
    function restHide() {
      if (!rest) return;
      if (idleTimer) {
        clearTimeout(idleTimer);
        idleTimer = 0;
      }
      rest.classList.remove('is-idle');
      rest.classList.add('is-gone');
    }
    function restSchedule() {
      if (!rest) return;
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(restIdle, 240);
    }
    function restHot(on) {
      if (!rest) return;
      if (on) rest.classList.add('is-hot');
      else rest.classList.remove('is-hot');
    }

    /**
     * 尾迹：不再逐段描线（那样快速划动时线段的空当会露出来），
     * 改为沿指针真实路径以 2.5px 间距连续盖墨点，墨与墨自然叠成一笔；
     * 淡出交给整层按时间衰减，所以浓淡是连续过渡，不会一段一段地断。
     */
    var lastX = null;
    var lastY = null;
    var lastAt = 0;
    var stampSpeed = 0.2;
    var lastStampAt = 0;

    function stamp(x, y, r, alpha) {
      tctx.globalAlpha = alpha;
      tctx.drawImage(trailDab, x - r, y - r, r * 2, r * 2);
    }

    function inkTo(x, y, now) {
      if (lastX === null) {
        lastX = x;
        lastY = y;
        lastAt = now;
        lastStampAt = now;
        stamp(x, y, 3.4, 0.18);
        tctx.globalAlpha = 1;
        return;
      }

      var dx = x - lastX;
      var dy = y - lastY;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 0.5) {
        lastAt = now;
        return;
      }

      var dt = Math.max(1, now - lastAt);
      stampSpeed = stampSpeed * 0.55 + (dist / dt) * 0.45;

      // 划得快时笔触略细，但浓度基本不减，保证快速甩动也看得出是一整笔
      var r = clamp(4.6 - stampSpeed * 0.5, 3.4, 4.6);
      var n = Math.min(700, Math.ceil(dist / STEP));
      var a = clamp(0.34 - stampSpeed * 0.02, 0.3, 0.34);

      for (var i = 1; i <= n; i += 1) {
        var f = i / n;
        stamp(lastX + dx * f, lastY + dy * f, r, a);
      }

      tctx.globalAlpha = 1;
      lastX = x;
      lastY = y;
      lastAt = now;
      lastStampAt = now;
    }

    // 指针离开窗口 / 跨进 iframe 时断开笔路，免得回来时画出一条横贯屏幕的直线
    function liftPen() {
      lastX = null;
      lastY = null;
      lastAt = 0;
    }

    /** 墨层按时间整体干去：先干的地方自然变淡，越新越浓 */
    function fadeTrail(now) {
      var dt = lastFrame ? Math.min(now - lastFrame, 1500) : 16;
      var gone = 1 - Math.exp(-dt / DRY);
      tctx.globalCompositeOperation = 'destination-out';
      tctx.globalAlpha = gone;
      tctx.fillStyle = '#000';
      tctx.fillRect(0, 0, W, H);
      tctx.globalCompositeOperation = 'source-over';
      tctx.globalAlpha = 1;
    }

    /** 圆角矩形的轮廓采样点（顺时针，起点在左上角之后） */
    function roundRectPoints(rect, step) {
      var rad = Math.min(14, Math.min(rect.width, rect.height) / 2);
      var pts = [];
      var L = rect.left;
      var T = rect.top;
      var R = rect.left + rect.width;
      var B = rect.top + rect.height;

      function line(x1, y1, x2, y2) {
        var d = Math.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
        var n = Math.max(1, Math.ceil(d / step));
        for (var i = 1; i <= n; i += 1) pts.push([x1 + (x2 - x1) * (i / n), y1 + (y2 - y1) * (i / n)]);
      }
      function arc(cx, cy, a0, a1) {
        var n = Math.max(2, Math.ceil((rad * Math.abs(a1 - a0)) / step));
        for (var i = 1; i <= n; i += 1) {
          var a = a0 + (a1 - a0) * (i / n);
          pts.push([cx + Math.cos(a) * rad, cy + Math.sin(a) * rad]);
        }
      }

      pts.push([L + rad, T]);
      line(L + rad, T, R - rad, T);
      arc(R - rad, T + rad, -Math.PI / 2, 0);
      line(R, T + rad, R, B - rad);
      arc(R - rad, B - rad, 0, Math.PI / 2);
      line(R - rad, B, L + rad, B);
      arc(L + rad, B - rad, Math.PI / 2, Math.PI);
      line(L, B - rad, L, T + rad);
      arc(L + rad, T + rad, Math.PI, Math.PI * 1.5);
      return pts;
    }

    /** 围框的浓淡：出现时淡入，离开后淡出 */
    function hoverLevel(now) {
      if (!hoverRect) return 0;
      if (hoverLeaveAt) return clamp(1 - (now - hoverLeaveAt) / 340, 0, 1);
      return clamp((now - hoverSince) / 240, 0, 1);
    }

    /**
     * 悬停：墨点沿目标描边围成一整圈，同时有一段更浓的“墨头”绕着走（方向随机）；
     * 每点都带墨晕，圈上疏密按周长自适应，绕一圈约 2.1 秒。
     */
    function drawHover(now) {
      rctx.clearRect(0, 0, W, H);

      var level = hoverLevel(now);
      if (!hoverRect || level < 0.02 || !hoverPoints.length) return;

      var len = hoverPoints.length;
      var t = (hoverLeaveAt || now) - hoverSince;
      var phase = (t / 2100) % 1;
      if (phase < 0) phase += 1;

      // 周长自适应：大致每 11px 一枚墨点，小标签也不会挤成一片
      var N = Math.max(16, Math.min(56, Math.round(len / 2.8)));
      var head = hoverDir > 0 ? phase : 1 - phase;

      for (var i = 0; i < N; i += 1) {
        var f0 = i / N;
        var f = hoverDir > 0 ? f0 + phase : f0 - phase;
        f = ((f % 1) + 1) % 1;

        var idx = Math.min(len - 1, Math.floor(f * len));
        var pt = hoverPoints[idx];

        // 离墨头越近越浓，对面最淡；整圈始终都有一层淡墨，所以能围成一圈
        var d = (f0 - head) % 1;
        if (d < 0) d += 1;
        var bump = Math.pow(0.5 + 0.5 * Math.cos(2 * Math.PI * d), 1.6);
        var a = level * (0.22 + 0.2 * bump);
        var r = 5.6 + 2 * bump;

        rctx.globalAlpha = clamp(a * 0.92, 0, 1);
        rctx.drawImage(ringDab, pt[0] - r, pt[1] - r, r * 2, r * 2);
      }
      rctx.globalAlpha = 1;
    }

    function frame() {
      var now = performance.now();

      // 围框淡出结束后清掉
      if (hoverRect && hoverLeaveAt && now - hoverLeaveAt > 360) {
        hoverRect = null;
        hoverLeaveAt = 0;
      }

      fadeTrail(now);
      drawHover(now);
      lastFrame = now;

      if (!hoverRect && now - lastStampAt > IDLE_STOP) {
        tctx.clearRect(0, 0, W, H);
        rctx.clearRect(0, 0, W, H);
        lastFrame = 0;
        running = false;
        return;
      }
      requestAnimationFrame(frame);
    }

    function ensureLoop() {
      if (running) return;
      running = true;
      lastFrame = 0;
      requestAnimationFrame(frame);
    }

    function hitTest(target) {
      if (!target || !target.closest) return null;
      return target.closest('a, button, input, select, textarea, .chip, .flag-btn, .lightbox');
    }

    function updateHover() {
      if (!hoverEl) {
        if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        return;
      }
      var r = hoverEl.getBoundingClientRect();
      if (r.width > 320 || r.height > 120 || r.width * r.height > 34000) {
        hoverEl = null;
        if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        return;
      }
      hoverRect = {
        left: r.left - 8,
        top: r.top - 8,
        width: r.width + 16,
        height: r.height + 16,
      };
      var sig = Math.round(hoverRect.left) + ',' + Math.round(hoverRect.top) + ',' + Math.round(hoverRect.width) + ',' + Math.round(hoverRect.height);
      if (hoverKey !== hoverEl) {
        hoverKey = hoverEl;
        hoverSince = performance.now();
        hoverLeaveAt = 0;
        hoverDir = Math.random() < 0.5 ? 1 : -1; // 顺时针或逆时针随机
        hoverPoints = roundRectPoints(hoverRect, 4);
        hoverPointsSig = sig;
      } else {
        hoverLeaveAt = 0;
        if (hoverPointsSig !== sig) {
          hoverPoints = roundRectPoints(hoverRect, 4);
          hoverPointsSig = sig;
        }
      }
    }

    document.addEventListener(
      'mousemove',
      function (e) {
        var x = e.clientX;
        var y = e.clientY;
        var now = performance.now();

        if (x >= 0 && y >= 0 && x <= W && y <= H) inkTo(x, y, now);

        placeRest(x, y);
        restWake();
        restSchedule();

        hoverEl = hitTest(e.target);
        updateHover();
        restHot(!!hoverRect);
        ensureLoop();
      },
      { passive: true }
    );

    // 移到内嵌 PDF / iframe 上时父页面收不到 mousemove，笔路断开、墨迹自行淡去
    document.addEventListener(
      'mouseover',
      function (e) {
        if (e.target && e.target.tagName === 'IFRAME') {
          hoverEl = null;
          liftPen();
          restHide();
          if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        }
      },
      true
    );

    document.addEventListener('mouseleave', function () {
      hoverEl = null;
      liftPen();
      restHide();
      if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
    });

    window.addEventListener(
      'scroll',
      function () {
        if (hoverEl) updateHover();
      },
      { passive: true }
    );

    // 切走窗口（Alt+Tab、点其它应用）时断开笔路，并把落点的墨收掉
    window.addEventListener('blur', function () {
      liftPen();
      restHide();
    });

    window.addEventListener('resize', function () {
      resize();
      liftPen();
    });
  })();
</script>
