<canvas class="ink-canvas" aria-hidden="true"></canvas>
<div class="ink-caret" aria-hidden="true">
  <span class="ink-caret-dot"></span>
  <span class="ink-caret-label"></span>
</div>

<script is:inline>
  (function () {
    var fine = window.matchMedia('(pointer: fine)').matches;
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || calm) return;

    var canvas = document.querySelector('.ink-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var caret = document.querySelector('.ink-caret');
    var caretDot = caret && caret.querySelector('.ink-caret-dot');
    var caretLabel = caret && caret.querySelector('.ink-caret-label');
    if (!caret || !caretDot || !caretLabel) return;

    // 隐藏系统指针，改由这一枚朱砂点代替
    document.documentElement.classList.add('has-ink-caret');

    var INK = '148, 55, 38'; // 朱砂，与之前粒子同色
    var LIFE = 900; // 墨迹存活时长（毫秒）
    var MAX_POINTS = 220;
    var SEG_STEP = 6; // 补点间距，越小笔迹越顺

    var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    var W = 0;
    var H = 0;

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
    }
    resize();

    var pts = []; // 最近经过的点：{x, y, t}
    var running = false;
    var hoverEl = null;
    var hoverRect = null;
    var hoverPoints = [];
    var hoverPointsSig = '';
    var hoverDir = 1;
    var hoverSince = 0;
    var hoverLeaveAt = 0;
    var hoverKey = null;
    var lastHeadAt = 0;
    var headX = 0;
    var headY = 0;
    var lastRender = 0;

    // 替代系统指针的朱砂点：当前位置缓动追目标位置
    var curX = 0;
    var curY = 0;
    var tgtX = 0;
    var tgtY = 0;
    var caretSeeded = false;
    var caretVisible = false;

    function labelFor(target) {
      if (!target || !target.closest) return '';
      var el = target.closest('a, button, input, select, textarea, .chip');
      if (!el) return '';
      if (el.matches('input, textarea')) return '输入';
      if (el.classList.contains('chip')) return '筛选';
      if (el.matches('a')) {
        var href = el.getAttribute('href') || '';
        if (/^\/writeups\/[^/]+\/?$/.test(href)) return '阅读';
        if (el.classList.contains('btn-primary')) return '开始';
        return '查看';
      }
      return '查看';
    }

    function clamp(v, lo, hi) {
      return v < lo ? lo : v > hi ? hi : v;
    }

    /** 墨迹：逐段描线，越靠后越淡越细，形成自然渐变拖尾 */
    function drawTrail(now) {
      if (pts.length < 2) return;

      for (var i = 1; i < pts.length; i += 1) {
        var p0 = pts[i - 1];
        var p1 = pts[i];
        var age = clamp((now - p1.t) / LIFE, 0, 1);
        var k = Math.pow(1 - age, 1.5); // 头部浓、尾部淡
        if (k <= 0.02) continue;

        // 宽度只跟随平滑后的速度，避免相邻线段粗细跳变留下珠状断点
        var thin = clamp(1.18 - p1.v * 0.55, 0.62, 1.12);

        // 洇开的淡边
        ctx.strokeStyle = 'rgba(' + INK + ',' + 0.075 * k + ')';
        ctx.lineWidth = 13 * thin * (0.3 + 0.7 * k);
        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.lineTo(p1.x, p1.y);
        ctx.stroke();

        // 主笔
        ctx.strokeStyle = 'rgba(' + INK + ',' + 0.20 * k + ')';
        ctx.lineWidth = 6.6 * thin * (0.3 + 0.7 * k);
        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.lineTo(p1.x, p1.y);
        ctx.stroke();
      }

      // 笔尖：刚移动过的地方留一小团湿墨，静止后自行淡去
      var headAge = clamp((now - lastHeadAt) / 520, 0, 1);
      var hk = Math.pow(1 - headAge, 1.4);
      if (hk > 0.03) {
        var g = ctx.createRadialGradient(headX, headY, 0, headX, headY, 9);
        g.addColorStop(0, 'rgba(' + INK + ',' + 0.17 * hk + ')');
        g.addColorStop(0.5, 'rgba(' + INK + ',' + 0.085 * hk + ')');
        g.addColorStop(1, 'rgba(' + INK + ',0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(headX, headY, 9, 0, Math.PI * 2, false);
        ctx.fill();
      }
    }

    /** 圆角矩形的轮廓采样点（顺时针，起点在左上角之后） */
    function roundRectPoints(rect, step) {
      var rad = Math.min(14, Math.min(rect.width, rect.height) / 2);
      var pts = [];
      var L = rect.left;
      var T = rect.top;
      var R = rect.left + rect.width;
      var B = rect.top + rect.height;

      function line(x1, y1, x2, y2) {
        var d = Math.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
        var n = Math.max(1, Math.ceil(d / step));
        for (var i = 1; i <= n; i += 1) pts.push([x1 + (x2 - x1) * (i / n), y1 + (y2 - y1) * (i / n)]);
      }
      function arc(cx, cy, a0, a1) {
        var n = Math.max(2, Math.ceil((rad * Math.abs(a1 - a0)) / step));
        for (var i = 1; i <= n; i += 1) {
          var a = a0 + (a1 - a0) * (i / n);
          pts.push([cx + Math.cos(a) * rad, cy + Math.sin(a) * rad]);
        }
      }

      pts.push([L + rad, T]);
      line(L + rad, T, R - rad, T);
      arc(R - rad, T + rad, -Math.PI / 2, 0);
      line(R, T + rad, R, B - rad);
      arc(R - rad, B - rad, 0, Math.PI / 2);
      line(R - rad, B, L + rad, B);
      arc(L + rad, B - rad, Math.PI / 2, Math.PI);
      line(L, B - rad, L, T + rad);
      arc(L + rad, T + rad, Math.PI, Math.PI * 1.5);
      return pts;
    }

    /** 围框的浓淡：出现时淡入，离开后淡出 */
    function hoverLevel(now) {
      if (!hoverRect) return 0;
      if (hoverLeaveAt) return clamp(1 - (now - hoverLeaveAt) / 340, 0, 1);
      return clamp((now - hoverSince) / 240, 0, 1);
    }

    /** 围框：像一笔绕着目标描过去，方向随机 */
    function drawHover(now) {
      var level = hoverLevel(now);
      if (!hoverRect || level < 0.02 || !hoverPoints.length) return;

      var p = hoverLeaveAt ? 1 : clamp((now - hoverSince) / 560, 0, 1);
      var count = Math.max(2, Math.round(hoverPoints.length * p));
      var list = [];
      var i;
      if (hoverDir > 0) {
        for (i = 0; i < count; i += 1) list.push(hoverPoints[i]);
      } else {
        for (i = hoverPoints.length - 1; i >= hoverPoints.length - count; i -= 1) list.push(hoverPoints[i]);
      }

      function trace() {
        ctx.beginPath();
        ctx.moveTo(list[0][0], list[0][1]);
        for (var k = 1; k < list.length; k += 1) ctx.lineTo(list[k][0], list[k][1]);
      }

      ctx.shadowColor = 'rgba(' + INK + ',' + 0.30 * level + ')';
      ctx.shadowBlur = 9;

      // 外层洇墨
      trace();
      ctx.strokeStyle = 'rgba(' + INK + ',' + 0.07 * level + ')';
      ctx.lineWidth = 9;
      ctx.stroke();

      // 主笔
      trace();
      ctx.strokeStyle = 'rgba(' + INK + ',' + 0.19 * level + ')';
      ctx.lineWidth = 2.6;
      ctx.stroke();

      ctx.shadowBlur = 0;

      // 笔锋还没走完时，落笔处点一小团浓墨
      if (p < 0.995) {
        var tip = list[list.length - 1];
        var g = ctx.createRadialGradient(tip[0], tip[1], 0, tip[0], tip[1], 7);
        g.addColorStop(0, 'rgba(' + INK + ',' + 0.3 * level + ')');
        g.addColorStop(1, 'rgba(' + INK + ',0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(tip[0], tip[1], 7, 0, Math.PI * 2, false);
        ctx.fill();
      }
    }

    function render(now) {
      ctx.clearRect(0, 0, W, H);
      drawHover(now);
      drawTrail(now);
      lastRender = now;
    }

    /** 朱砂点向指针位置缓动，跟手但不僵 */
    function moveCaret() {
      var dx = tgtX - curX;
      var dy = tgtY - curY;
      curX += dx * 0.28;
      curY += dy * 0.28;
      caret.style.transform = 'translate3d(' + curX.toFixed(2) + 'px,' + curY.toFixed(2) + 'px,0)';
    }

    function frame() {
      var now = performance.now();

      // 淘汰过期的点
      while (pts.length && now - pts[0].t > LIFE) pts.shift();

      // 围框淡出结束后清掉
      if (hoverRect && hoverLeaveAt && now - hoverLeaveAt > 360) {
        hoverRect = null;
        hoverLeaveAt = 0;
      }

      moveCaret();
      render(now);

      var headFading = now - lastHeadAt < 560;
      var caretMoving = Math.abs(tgtX - curX) + Math.abs(tgtY - curY) > 0.6;
      if (!pts.length && !hoverRect && !headFading && !caretMoving) {
        ctx.clearRect(0, 0, W, H);
        running = false;
        return;
      }
      requestAnimationFrame(frame);
    }

    function ensureLoop() {
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    }

    function hitTest(target) {
      if (!target || !target.closest) return null;
      return target.closest('a, button, input, select, textarea, .chip, .flag-btn, .lightbox');
    }

    function updateHover() {
      if (!hoverEl) {
        if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        return;
      }
      var r = hoverEl.getBoundingClientRect();
      if (r.width > 320 || r.height > 120 || r.width * r.height > 34000) {
        hoverEl = null;
        if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        return;
      }
      hoverRect = {
        left: r.left - 8,
        top: r.top - 8,
        width: r.width + 16,
        height: r.height + 16,
      };
      var sig = Math.round(hoverRect.left) + ',' + Math.round(hoverRect.top) + ',' + Math.round(hoverRect.width) + ',' + Math.round(hoverRect.height);
      if (hoverKey !== hoverEl) {
        hoverKey = hoverEl;
        hoverSince = performance.now();
        hoverLeaveAt = 0;
        hoverDir = Math.random() < 0.5 ? 1 : -1; // 顺时针或逆时针随机
        hoverPoints = roundRectPoints(hoverRect, 4);
        hoverPointsSig = sig;
      } else {
        hoverLeaveAt = 0;
        if (hoverPointsSig !== sig) {
          hoverPoints = roundRectPoints(hoverRect, 4);
          hoverPointsSig = sig;
        }
      }
    }

    document.addEventListener(
      'mousemove',
      function (e) {
        var x = e.clientX;
        var y = e.clientY;
        var now = performance.now();

        var last = pts[pts.length - 1];
        if (!last) {
          pts.push({ x: x, y: y, t: now, v: 0.2 });
        } else {
          var mx = x - last.x;
          var my = y - last.y;
          var dist = Math.sqrt(mx * mx + my * my);
          var dt = Math.max(1, now - last.t);
          // 速度做平滑，避免线段宽度忽粗忽细
          var speed = last.v * 0.6 + (dist / dt) * 0.4;

          if (dist > SEG_STEP) {
            // 指针快速甩动时两次事件之间距离很大，这里补插中间点，笔迹才不会断成一段段
            var n = Math.min(48, Math.ceil(dist / SEG_STEP));
            for (var s = 1; s <= n; s += 1) {
              var f = s / n;
              pts.push({
                x: last.x + mx * f,
                y: last.y + my * f,
                t: last.t + dt * f,
                v: speed,
              });
            }
          } else if (dist > 2) {
            pts.push({ x: x, y: y, t: now, v: speed });
          } else {
            last.t = now;
            last.v = speed;
          }
          while (pts.length > MAX_POINTS) pts.shift();
        }

        headX = x;
        headY = y;
        lastHeadAt = now;

        // 朱砂点：首次出现直接对齐，之后缓动跟随
        tgtX = x;
        tgtY = y;
        if (!caretSeeded) {
          caretSeeded = true;
          curX = x;
          curY = y;
          caret.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
        }
        if (!caretVisible) {
          caretVisible = true;
          caret.classList.add('is-on');
        }

        hoverEl = hitTest(e.target);
        var label = labelFor(e.target);
        if (label) {
          caretLabel.textContent = label;
          caret.classList.add('is-hot');
        } else {
          caret.classList.remove('is-hot');
        }
        updateHover();
        // 立刻出一帧，指针移动时反馈不依赖下一帧
        if (now - lastRender > 8) render(now);
        ensureLoop();
      },
      { passive: true }
    );

    // 移到内嵌 PDF / iframe 上时父页面收不到 mousemove，墨迹自行淡去
    document.addEventListener(
      'mouseover',
      function (e) {
        if (e.target && e.target.tagName === 'IFRAME') {
          hoverEl = null;
          caretVisible = false;
          caret.classList.remove('is-on');
          caret.classList.remove('is-hot');
          if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
        }
      },
      true
    );

    document.addEventListener('mouseleave', function () {
      hoverEl = null;
      caretVisible = false;
      caret.classList.remove('is-on');
      caret.classList.remove('is-hot');
      if (hoverRect && !hoverLeaveAt) hoverLeaveAt = performance.now();
    });

    window.addEventListener(
      'scroll',
      function () {
        if (hoverEl) updateHover();
      },
      { passive: true }
    );

    window.addEventListener('resize', function () {
      resize();
      pts.length = 0;
    });
  })();
</script>
