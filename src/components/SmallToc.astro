---
import type { TocGroup } from '../utils/toc';

interface Props {
  title: string;
  groups: TocGroup[];
}

const { title, groups } = Astro.props;
---

<aside class="toc" id="toc" aria-label={title} aria-hidden="true" inert>
  <div class="toc-head">
    <span class="toc-title">{title}</span>
    <button class="toc-close" id="toc-close" type="button" aria-label="关闭目录">×</button>
  </div>
  <ul class="toc-list">
    {
      groups.map((group, gi) => (
        <li
          class="toc-group"
          data-current={group.current ? 'true' : undefined}
          data-name={group.name}
        >
          {group.children && group.children.length > 0 ? (
            <>
              <a
                class="toc-h2 toc-group-head has-sub"
                href={group.href ?? '#'}
                data-sub={`g-${gi}`}
                aria-expanded="false"
              >
                <span class="toc-text">{group.name}</span>
                {group.meta && <span class="toc-count">{group.meta}</span>}
                <span class="toc-caret" aria-hidden="true">›</span>
              </a>
              <ul class="toc-sub toc-group-sub" id={`toc-sub-g-${gi}`} hidden>
                {group.children.map((child, ci) => (
                  <li
                    class={child.headings && child.headings.length > 0 ? 'toc-post' : 'toc-leaf'}
                    data-current={child.current ? 'true' : 'false'}
                  >
                    {child.headings && child.headings.length > 0 ? (
                      <>
                        <a
                          class="toc-h2 has-sub"
                          href={child.href}
                          data-sub={`p-${gi}-${ci}`}
                          aria-expanded="false"
                        >
                          <span class="toc-text">{child.name}</span>
                          <span class="toc-caret" aria-hidden="true">›</span>
                        </a>
                        <ul class="toc-sub" id={`toc-sub-p-${gi}-${ci}`} hidden>
                          {child.headings.map((heading) => (
                            <li class={heading.depth === 3 ? 'is-deep' : ''}>
                              <a href={heading.href ?? `#${heading.slug}`}>{heading.text}</a>
                            </li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <a class="toc-h2" href={child.href}>
                        <span class="toc-text">{child.name}</span>
                        {child.meta && <span class="toc-count">{child.meta}</span>}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a class="toc-h2 toc-group-head" href={group.href ?? '#'}>
              <span class="toc-text">{group.name}</span>
              {group.meta && <span class="toc-count">{group.meta}</span>}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</aside>

<script is:inline>
  (function () {
    const panel = document.getElementById('toc');
    if (!panel) return;
    const trigger = document.getElementById('toc-toggle');
    const closeBtn = document.getElementById('toc-close');
    const navbar = document.querySelector('.navbar');
    const navTools = document.querySelector('.nav-tools');
    const tocList = panel.querySelector('.toc-list');
    let isOpen = false;

    if (trigger) {
      trigger.setAttribute('aria-controls', 'toc');
      trigger.setAttribute('aria-expanded', 'false');
    }

    function place() {
      if (!navbar) return;
      const top = Math.round(navbar.getBoundingClientRect().bottom + 8);
      const anchor = navTools || navbar;
      const right = Math.max(12, Math.round(window.innerWidth - anchor.getBoundingClientRect().right));
      panel.style.setProperty('--toc-top', top + 'px');
      panel.style.setProperty('--toc-right', right + 'px');
      panel.style.setProperty('--toc-max', Math.max(200, window.innerHeight - top - 16) + 'px');
    }

    function revealCurrent() {
      if (!tocList) return;
      const current =
        panel.querySelector('.toc-post[data-current="true"]') ||
        panel.querySelector('.toc-group[data-current="true"]');
      if (!current) return;
      const listRect = tocList.getBoundingClientRect();
      const itemRect = current.getBoundingClientRect();
      if (itemRect.top < listRect.top || itemRect.top > listRect.bottom - 24) {
        tocList.scrollTop += itemRect.top - listRect.top - 2;
      }
    }

    function setOpen(next, focusTrigger) {
      isOpen = next;
      panel.classList.toggle('is-open', next);
      panel.setAttribute('aria-hidden', next ? 'false' : 'true');
      if (next) panel.removeAttribute('inert');
      else panel.setAttribute('inert', '');
      if (trigger) trigger.setAttribute('aria-expanded', next ? 'true' : 'false');
      if (next) {
        place();
        if (closeBtn) closeBtn.focus({ preventScroll: true });
        requestAnimationFrame(revealCurrent);
      } else if (focusTrigger && trigger) {
        trigger.focus({ preventScroll: true });
      }
    }

    if (trigger) {
      trigger.addEventListener('click', function (e) {
        /* 有分区小目录时，单击打开浮层；双击留给完整目录页 */
        e.preventDefault();
        if (e.detail > 1) return;
        setOpen(!isOpen);
      });
      trigger.addEventListener('dblclick', function (e) {
        e.preventDefault();
        window.location.href = trigger.getAttribute('href') || '/toc/';
      });
    }
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        setOpen(false, true);
      });
    }
    document.addEventListener('click', function (e) {
      if (!isOpen) return;
      if (panel.contains(e.target) || (trigger && trigger.contains(e.target))) return;
      setOpen(false, false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) setOpen(false, true);
    });
    window.addEventListener('resize', function () {
      if (isOpen) place();
    });

    function setGroup(link, open) {
      const sub = document.getElementById('toc-sub-' + link.getAttribute('data-sub'));
      if (!sub) return;
      link.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) sub.removeAttribute('hidden');
      else sub.setAttribute('hidden', '');
    }

    function jumpTo(hash) {
      if (!hash) return;
      const el = document.getElementById(decodeURIComponent(hash.slice(1)));
      if (!el) return;
      if (history.pushState) history.pushState(null, '', hash);
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function go(href) {
      if (!href) return;
      if (href.charAt(0) === '#') jumpTo(href);
      else window.location.href = href;
    }

    panel.querySelectorAll('.has-sub').forEach(function (link) {
      /* 单击：立即展开 / 收起这一组；双击的第二下不再重复切换 */
      link.addEventListener('click', function (e) {
        e.preventDefault();
        if (e.detail > 1) return;
        setGroup(link, link.getAttribute('aria-expanded') !== 'true');
      });
      /* 双击：分类名 → 去筛选；文章名 → 打开文章 */
      link.addEventListener('dblclick', function (e) {
        e.preventDefault();
        go(link.getAttribute('href'));
      });
      link.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        go(link.getAttribute('href'));
      });
    });

    /* 点章节书签后收起浮层，把视线还给正文；分类的展开/收起不受影响 */
    panel.addEventListener('click', function (e) {
      const link = e.target.closest('a');
      if (!link || link.classList.contains('has-sub')) return;
      if (link.getAttribute('href').charAt(0) === '#') setOpen(false, false);
    });

    /* 当前分类：优先用页面标注，列表页则跟随 ?cat= */
    let currentGroup = panel.querySelector('.toc-group[data-current="true"]');
    if (!currentGroup) {
      const preset = new URLSearchParams(location.search).get('cat');
      if (preset) {
        currentGroup =
          Array.from(panel.querySelectorAll('.toc-group')).find(function (g) {
            return g.getAttribute('data-name') === preset;
          }) || null;
        if (currentGroup) currentGroup.setAttribute('data-current', 'true');
      }
    }
    if (currentGroup) {
      const groupToggle = currentGroup.querySelector('.toc-group-head.has-sub');
      if (groupToggle) setGroup(groupToggle, true);
    }

    /* 当前这篇默认展开，读者一眼看到自己的章节 */
    const currentPost = panel.querySelector('.toc-post[data-current="true"]');
    if (currentPost) {
      const currentToggle = currentPost.querySelector('.has-sub');
      if (currentToggle) setGroup(currentToggle, true);
    }

    /* ---------- 目录滚动高亮（只跟踪当前文章） ---------- */
    const tocLinks = currentPost ? Array.from(currentPost.querySelectorAll('.toc-sub a')) : [];
    if (!tocLinks.length) return;

    const targets = tocLinks
      .map(function (a) {
        const el = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
        return el ? { link: a, el: el } : null;
      })
      .filter(Boolean);

    function onScroll() {
      let current = targets[0];
      targets.forEach(function (t) {
        if (t.el.getBoundingClientRect().top <= 130) current = t;
      });
      tocLinks.forEach(function (a) {
        a.classList.remove('active');
      });
      if (!current) return;
      current.link.classList.add('active');

      /* 滚到某一节时，若这篇文章的书签被手动收起了，就顺手展开 */
      const sub = current.link.closest('.toc-sub');
      if (sub && sub.hasAttribute('hidden')) {
        const toggle = sub.parentElement.querySelector('.has-sub');
        if (toggle) setGroup(toggle, true);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
