---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES } from '../consts';
import { visiblePosts, tagCounts, formatDate } from '../utils/posts';

const all = visiblePosts(await getCollection('writeups'));
const tags = tagCounts(all);
const cats = CATEGORIES.filter((c) => all.some((p) => p.data.category === c));
const lastUpdate = all.length
  ? new Date(
      Math.max(...all.map((p) => (p.data.updatedAt ?? p.data.publishedAt).getTime()))
    )
  : null;
---

<BaseLayout title="关于" description="关于我、联系方式。">
  <div class="wrap">
    <section class="article-top">
      <p class="breadcrumb">
        <a href="/">~</a><span class="sep">/</span><span>about</span>
      </p>
      <h1>关于</h1>
    </section>

    <div class="profile">
      <div class="avatar" aria-hidden="true">S</div>
      <div>
        <h2>{SITE.author}</h2>
        <div class="contact-row">
          <a href={`mailto:${SITE.email}`}>email</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">github</a>
          <a href="/rss.xml">rss</a>
        </div>
      </div>
    </div>

    <div class="stats stats-about">
      <div class="stat">
        <b>{all.length}</b>
        <span>篇文章</span>
      </div>
      <div class="stat">
        <b>{tags.length}</b>
        <span>个标签</span>
      </div>
      <div class="stat">
        <b>{cats.length}</b>
        <span>个分类</span>
      </div>
      <div class="stat">
        <b class="stat-date">{lastUpdate ? formatDate(lastUpdate) : '—'}</b>
        <span>最后更新</span>
      </div>
    </div>
  </div>
</BaseLayout>
