---
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SmallToc from '../components/SmallToc.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES } from '../consts';
import { visiblePosts, tagCounts, formatDate, categoryCounts } from '../utils/posts';
import type { TocGroup } from '../utils/toc';

const all = visiblePosts(await getCollection('writeups'));
const tags = tagCounts(all);
const cats = categoryCounts(all, CATEGORIES);
const tocGroups: TocGroup[] = [{ name: '关于作者', href: '/about/', current: true }];

/** 「最后更新」跟着最近改过的那篇文章走，点进去就是它 */
const latestPost = all.length
  ? [...all].sort(
      (a, b) =>
        (b.data.updatedAt ?? b.data.publishedAt).getTime() -
        (a.data.updatedAt ?? a.data.publishedAt).getTime()
    )[0]
  : null;
const lastUpdate = latestPost ? latestPost.data.updatedAt ?? latestPost.data.publishedAt : null;
---

<BaseLayout title="关于" description="关于我、联系方式。">
  <div class="wrap about-page">
    <section class="article-top">
      <Breadcrumb segments={[{ label: 'about' }]} />
      <h1>关于</h1>
    </section>

    <div class="article-grid">
      <div class="page-main">
        <div class="profile">
          <div class="avatar">
            <img src="/avatar.jpg" alt={`${SITE.author} 的头像`} width="72" height="72" />
          </div>
          <div class="profile-body">
            <h2>{SITE.author}</h2>
            <ul class="contact-list">
              <li>
                <span class="contact-label">email：</span>
                <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
              </li>
              <li>
                <span class="contact-label">github：</span>
                <a href={SITE.github} target="_blank" rel="noopener noreferrer">{SITE.github}</a>
              </li>
            </ul>
          </div>
        </div>

        <div class="stats stats-about">
          <a class="stat" data-no-ink href="/writeups/" aria-label={`查看全部 ${all.length} 篇文章`}>
            <b>{all.length}</b>
            <span class="stat-label">文章<span class="stat-arrow" aria-hidden="true">↗</span></span>
          </a>
          <a class="stat" data-no-ink href="/tags/#tags" aria-label={`查看 ${tags.length} 个标签`}>
            <b>{tags.length}</b>
            <span class="stat-label">标签<span class="stat-arrow" aria-hidden="true">↗</span></span>
          </a>
          <a class="stat" data-no-ink href="/tags/#categories" aria-label={`查看 ${cats.length} 个分类`}>
            <b>{cats.length}</b>
            <span class="stat-label">分类<span class="stat-arrow" aria-hidden="true">↗</span></span>
          </a>
          <a
            class="stat"
            data-no-ink
            href={latestPost ? `/writeups/${latestPost.id}/` : '/writeups/'}
            aria-label={latestPost ? `查看最近更新的文章：${latestPost.data.title}` : '查看文章'}
          >
            <b class="stat-date">{lastUpdate ? formatDate(lastUpdate) : '—'}</b>
            <span class="stat-label">最后更新<span class="stat-arrow" aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>

      <SmallToc title="关于目录" groups={tocGroups} />
    </div>
  </div>
</BaseLayout>
