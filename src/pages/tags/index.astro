---
import Breadcrumb from '../../components/Breadcrumb.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { visiblePosts, tagCounts } from '../../utils/posts';

const all = visiblePosts(await getCollection('writeups'));
const tags = tagCounts(all);
---

<BaseLayout title="标签" description="按标签浏览全部文章。">
  <div class="wrap">
    <section class="article-top">
      <Breadcrumb segments={[{ label: 'tags' }]} />
      <h1>标签</h1>
      <div class="article-meta">
        <span>{tags.length} 个标签</span>
      </div>
    </section>

    {
      tags.length > 0 && (
        <div class="tag-cloud">
          {tags.map((t) => (
            <a href={`/tags/${encodeURIComponent(t.tag)}/`}>
              {t.tag}
              <span class="n">{t.count}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
