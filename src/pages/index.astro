---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout description={SITE.description}>
  <section class="hero wrap">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/writeups/">开始阅读</a>
      <a class="btn" href="/about/">关于作者</a>
    </div>
  </section>
  <!-- 入场：欢迎语停一下，再「拉近」收成首页的标题与那一行 -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bg"></div>
    <div class="intro-stage">
      <p class="intro-hello">欢迎来到</p>
      <p class="intro-brand" id="introBrand">{SITE.title}</p>
      <p class="intro-name" id="introName">{SITE.description}</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var intro = document.getElementById('intro');
    if (!intro) return;
    var brandEl = document.getElementById('introBrand');
    var nameEl = document.getElementById('introName');
    var hello = intro.querySelector('.intro-hello');
    var bg = intro.querySelector('.intro-bg');
    var h1 = document.querySelector('.hero h1');
    var lead = document.querySelector('.hero .lead');
    var doc = document.documentElement;

    if (!lead || !h1 || !nameEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      intro.remove();
      return;
    }

    intro.style.display = 'grid';
    doc.classList.add('intro-on');
    // 首页的标题与那一行先藏着，等入场的大字落到它们的位置上再换过来
    h1.style.opacity = '0';
    lead.style.opacity = '0';

    function finish() {
      intro.remove();
      doc.classList.remove('intro-on');
    }

    /** 算出「从当前位置缩成目标元素」的位移与比例，原点取文本框中心 */
    function land(el, target) {
      var a = el.getBoundingClientRect();
      var elf = parseFloat(getComputedStyle(el).fontSize);
      var taf = parseFloat(getComputedStyle(target).fontSize);
      var s = Math.min(1, Math.max(0.12, taf / elf));
      var b = target.getBoundingClientRect();
      return {
        scale: s,
        transform:
          'translate(' +
          (b.left - a.left - (a.width - a.width * s) / 2) +
          'px,' +
          (b.top - a.top - (a.height - a.height * s) / 2) +
          'px) scale(' +
          s +
          ')',
      };
    }

    function start() {
      // ① 先停在欢迎语上，同时轻轻压近（1.06 倍，900ms）
      brandEl.style.transition = 'transform 900ms cubic-bezier(.25,.6,.3,1)';
      nameEl.style.transition = 'transform 900ms cubic-bezier(.25,.6,.3,1)';
      brandEl.style.transform = 'scale(1.06)';
      nameEl.style.transform = 'scale(1.06)';

      var brandLand = land(brandEl, h1);
      var nameLand = land(nameEl, lead);

      // ② 1200ms 后才让「欢迎来到」淡出，之前一直看得见
      setTimeout(function () {
        hello.style.opacity = '0';
        hello.style.transform = 'translateY(-10px)';
      }, 1200);

      // ③ 1250ms 起把两行大字收进首页，纸色底同时化开
      setTimeout(function () {
        var ease = 'transform 1200ms cubic-bezier(.55,.06,.24,1)';
        brandEl.style.transition = ease;
        nameEl.style.transition = ease;
        brandEl.style.transform = brandLand.transform;
        nameEl.style.transform = nameLand.transform;
        bg.style.transition = 'opacity 1000ms ease';
        bg.style.opacity = '0';

        // ④ 位置已经对上，两边交叉淡出换成页面里真正的标题与那一行
        setTimeout(function () {
          brandEl.style.transition = 'opacity 260ms linear';
          nameEl.style.transition = 'opacity 260ms linear';
          brandEl.style.opacity = '0';
          nameEl.style.opacity = '0';
          h1.style.transition = 'opacity 260ms linear';
          lead.style.transition = 'opacity 260ms linear';
          h1.style.opacity = '1';
          lead.style.opacity = '1';
          setTimeout(finish, 280);
        }, 1060);
      }, 1250);
    }

    // 等字体到位再量位置，最多等 700ms，避免用正楷量、行楷显示
    Promise.race([
      document.fonts ? document.fonts.ready : Promise.resolve(),
      new Promise(function (r) {
        setTimeout(r, 700);
      }),
    ]).then(start);
  })();
</script>
