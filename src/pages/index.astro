---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout description={SITE.description}>
  <section class="hero wrap">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/writeups/">开始阅读</a>
      <a class="btn" href="/about/">关于作者</a>
    </div>
  </section>
  <!-- 入场：欢迎语停一下，再「拉近」收成首页的标题与那一行 -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bg"></div>
    <div class="intro-stage">
      <p class="intro-hello">欢迎来到</p>
      <p class="intro-brand" id="introBrand">{SITE.title}</p>
      <p class="intro-name" id="introName">{SITE.description}</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var intro = document.getElementById('intro');
    if (!intro) return;
    var brandEl = document.getElementById('introBrand');
    var nameEl = document.getElementById('introName');
    var hello = intro.querySelector('.intro-hello');
    var bg = intro.querySelector('.intro-bg');
    var h1 = document.querySelector('.hero h1');
    var lead = document.querySelector('.hero .lead');
    var doc = document.documentElement;

    if (!lead || !h1 || !nameEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      intro.remove();
      doc.classList.remove('intro-on');
      return;
    }

    // 只在本次进站（同一个标签页会话）第一次打开时播一次；
    // 想在浏览器里再看一遍，地址后面加 ?intro=1 即可
    var KEY = 'shaloworld-intro-seen';
    var replay = /[?&]intro=1(&|$)/.test(location.search);
    var seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch (e) {}
    if (seen && !replay) {
      intro.remove();
      doc.classList.remove('intro-on');
      return;
    }
    try {
      sessionStorage.setItem(KEY, '1');
    } catch (e) {}

    intro.style.display = 'grid';
    doc.classList.add('intro-on');
    // 首页的标题与那一行先藏着，等入场的大字落到它们的位置上再换过来
    h1.style.opacity = '0';
    lead.style.opacity = '0';

    function finish() {
      intro.remove();
      doc.classList.remove('intro-on');
    }

    /** 算出「从当前位置缩成目标元素」的位移与比例，原点取文本框中心 */
    function land(el, target) {
      var a = el.getBoundingClientRect();
      var elf = parseFloat(getComputedStyle(el).fontSize);
      var taf = parseFloat(getComputedStyle(target).fontSize);
      var s = Math.min(1, Math.max(0.12, taf / elf));
      var b = target.getBoundingClientRect();
      return {
        scale: s,
        transform:
          'translate(' +
          (b.left - a.left - (a.width - a.width * s) / 2) +
          'px,' +
          (b.top - a.top - (a.height - a.height * s) / 2) +
          'px) scale(' +
          s +
          ')',
      };
    }

    function delay(ms) {
      return new Promise(function (r) {
        setTimeout(r, ms);
      });
    }

    function beginLand() {
      var brandLand = land(brandEl, h1);
      var nameLand = land(nameEl, lead);

      hello.style.opacity = '0';
      hello.style.transform = 'translateY(-10px)';

      var ease = 'transform 1000ms cubic-bezier(.55,.06,.24,1)';
      brandEl.style.transition = ease;
      nameEl.style.transition = ease;
      brandEl.style.transform = brandLand.transform;
      nameEl.style.transform = nameLand.transform;

      // 移动的整整一秒里，背景保持不透明，页头和按钮都不出现；
      // 到位后再停半秒，才让整页慢慢浮出来
      setTimeout(revealPage, 1500);
    }

    function revealPage() {
      bg.style.transition = 'opacity 900ms cubic-bezier(.22,.61,.24,1)';
      bg.style.opacity = '0';

      brandEl.style.transition = 'opacity 320ms linear';
      nameEl.style.transition = 'opacity 320ms linear';
      brandEl.style.opacity = '0';
      nameEl.style.opacity = '0';

      h1.style.transition = 'opacity 620ms cubic-bezier(.22,.61,.24,1)';
      lead.style.transition = 'opacity 620ms cubic-bezier(.22,.61,.24,1)';
      h1.style.opacity = '1';
      lead.style.opacity = '1';

      doc.classList.remove('intro-on');
      setTimeout(finish, 980);
    }

    /**
     * 入场写字：每一笔都是站点字体本身切出来的一块完整笔画，
     * 按笔顺逐笔推开。底字和最终显示的字同源同形，不会出现
     * 楷体骨架与文楷字形对不上、写到一半只剩零碎边角的问题。
     */
    var SEG = {};
    var segReady = null;

    function loadSegments() {
      if (segReady) return segReady;
      segReady = fetch('/strokes/segments.json')
        .then(function (r) {
          return r.json();
        })
        .then(function (data) {
          var jobs = [];
          Object.keys(data).forEach(function (ch) {
            var list = data[ch].strokes || [];
            list.forEach(function (s) {
              var img = new Image();
              s.img = img;
              jobs.push(
                new Promise(function (res) {
                  img.onload = function () {
                    res();
                  };
                  img.onerror = function () {
                    res();
                  };
                  img.src = s.d;
                })
              );
            });
            SEG[ch] = list;
          });
          return Promise.all(jobs).then(function () {
            return SEG;
          });
        });
      return segReady;
    }

    /** 把这一笔的透明遮罩染成墨色，之后直接当整块笔画贴上去 */
    function tintStroke(img, color) {
      var c = document.createElement('canvas');
      c.width = img.naturalWidth;
      c.height = img.naturalHeight;
      var t = c.getContext('2d');
      t.drawImage(img, 0, 0);
      t.globalCompositeOperation = 'source-in';
      t.fillStyle = color;
      t.fillRect(0, 0, c.width, c.height);
      return c;
    }

    function buildLine(el, text, color) {
      var rect = el.getBoundingClientRect();
      var style = getComputedStyle(el);
      var size = parseFloat(style.fontSize);
      var ls = parseFloat(style.letterSpacing) || 0;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var font =
        (style.fontStyle && style.fontStyle !== 'normal' ? style.fontStyle + ' ' : '') +
        (style.fontWeight || '400') +
        ' ' +
        style.fontSize +
        ' ' +
        style.fontFamily;

      // 画布四周留余量，字形的起笔、捺脚和字母外伸都画得下
      var pad = Math.max(8, Math.round(size * 0.36));
      var cvs = document.createElement('canvas');
      cvs.width = Math.max(1, Math.round((rect.width + pad * 2) * dpr));
      cvs.height = Math.max(1, Math.round((rect.height + pad * 2) * dpr));
      cvs.style.cssText =
        'position:absolute;left:' +
        -pad +
        'px;top:' +
        -pad +
        'px;width:' +
        (rect.width + pad * 2) +
        'px;height:' +
        (rect.height + pad * 2) +
        'px;pointer-events:none;';
      el.style.position = 'relative';
      el.appendChild(cvs);

      var ctx = cvs.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.textBaseline = 'alphabetic';
      ctx.font = font;

      var met = ctx.measureText(text);
      var asc = met.fontBoundingBoxAscent || size * 0.82;
      var desc = met.fontBoundingBoxDescent || size * 0.22;
      var baseline = pad + (rect.height - (asc + desc)) / 2 + asc;

      // 逐字排版，位置和字距跟 CSS 保持一致
      var glyphs = [];
      var widths = [];
      var totalW = 0;
      for (var i = 0; i < text.length; i += 1) {
        var ch = text.charAt(i);
        var w = ctx.measureText(ch).width;
        widths.push(w);
        totalW += w + (i < text.length - 1 ? ls : 0);
        glyphs.push({ ch: ch, w: w, space: ch === ' ' });
      }
      var startX = pad + (rect.width - totalW) / 2;
      var penX = startX;
      for (var g = 0; g < glyphs.length; g += 1) {
        glyphs[g].x = penX;
        penX += glyphs[g].w + (g < glyphs.length - 1 ? ls : 0);
      }

      // 笔画块是 1000 单位字身框里的坐标，按字号缩放后贴到基线位置
      var scale = size / 1000;
      var strokes = [];
      var total = 0;
      glyphs.forEach(function (gl) {
        if (gl.space) return;
        var list = SEG[gl.ch] || [];
        list.forEach(function (s) {
          if (!s.img || !s.img.naturalWidth) return;
          var sw = Math.max(0.1, (s.x1 - s.x0) * scale);
          var sh = Math.max(0.1, (s.y1 - s.y0) * scale);
          var sx = gl.x + s.x0 * scale;
          var sy = baseline - s.y1 * scale;
          var wt = Math.max(6, s.wt || 20);
          strokes.push({
            img: tintStroke(s.img, color),
            x: sx,
            y: sy,
            w: sw,
            h: sh,
            wt: wt,
            start: total,
            dx: s.dx || 1,
            dy: -(s.dy || 0),
          });
          total += wt;
        });
      });

      return {
        ctx: ctx,
        w: rect.width + pad * 2,
        h: rect.height + pad * 2,
        font: font,
        color: color,
        baseline: baseline,
        glyphs: glyphs,
        strokes: strokes,
        total: total || 1,
      };
    }

    /** 用最终字体把整行字画出来，收笔时用来补齐笔画之间的接缝 */
    function paintGlyphs(view, target, color, alpha) {
      target.save();
      target.globalAlpha = alpha == null ? 1 : alpha;
      target.font = view.font;
      target.fillStyle = color;
      target.textBaseline = 'alphabetic';
      for (var i = 0; i < view.glyphs.length; i += 1) {
        var gl = view.glyphs[i];
        if (!gl.space) target.fillText(gl.ch, gl.x, view.baseline);
      }
      target.restore();
    }

    /** 这一笔写到 q（0~1）：沿起笔到收笔的方向把这一整块笔画推出来 */
    function drawStroke(view, s, q, alpha) {
      var ctx = view.ctx;
      ctx.save();
      ctx.globalAlpha = alpha;
      if (q >= 1) {
        ctx.drawImage(s.img, s.x, s.y, s.w, s.h);
        ctx.restore();
        return;
      }
      var dx = s.dx;
      var dy = s.dy;
      var m = Math.sqrt(dx * dx + dy * dy);
      if (m < 0.001) {
        dx = 1;
        dy = 0;
        m = 1;
      }
      dx /= m;
      dy /= m;
      var cx = s.x + s.w / 2;
      var cy = s.y + s.h / 2;
      var corners = [
        [s.x, s.y],
        [s.x + s.w, s.y],
        [s.x + s.w, s.y + s.h],
        [s.x, s.y + s.h],
      ];
      var dmin = Infinity;
      var dmax = -Infinity;
      corners.forEach(function (c) {
        var d = c[0] * dx + c[1] * dy;
        if (d < dmin) dmin = d;
        if (d > dmax) dmax = d;
      });
      var t = dmin + q * (dmax - dmin) + 1;
      var dc = cx * dx + cy * dy;
      var px = cx + dx * (t - dc);
      var py = cy + dy * (t - dc);
      var nx = -dy;
      var ny = dx;
      var L = Math.max(s.w, s.h) * 2 + 40;
      var poly = [
        [px + nx * L, py + ny * L],
        [px - nx * L, py - ny * L],
        [px - nx * L - dx * L, py - ny * L - dy * L],
        [px + nx * L - dx * L, py + ny * L - dy * L],
      ];
      ctx.beginPath();
      ctx.moveTo(poly[0][0], poly[0][1]);
      for (var i = 1; i < poly.length; i += 1) ctx.lineTo(poly[i][0], poly[i][1]);
      ctx.closePath();
      ctx.clip();
      ctx.drawImage(s.img, s.x, s.y, s.w, s.h);
      ctx.restore();
    }

    /** p 从 0 到 1：按笔顺把这一行写完 */
    function drawLine(view, p) {
      var ctx = view.ctx;
      ctx.clearRect(0, 0, view.w, view.h);
      var vis = p * view.total;
      for (var i = 0; i < view.strokes.length; i += 1) {
        var s = view.strokes[i];
        if (vis <= s.start) break;
        var q = Math.min(1, (vis - s.start) / s.wt);
        // 每一笔从起笔方向推出来，切口落在笔画自身形状里
        drawStroke(view, s, q, 1);
      }

      // 最后一瞬用同一字体的完整字形收口，把笔画接缝抹平；
      // 因为字形完全一致，看不出替换
      if (p > 0.97) {
        paintGlyphs(view, ctx, view.color, (p - 0.97) / 0.03);
      }
    }

    /** 一行在 duration 毫秒内按笔顺写完 */
    function writeLine(view, duration) {
      return new Promise(function (resolve) {
        var t0 = performance.now();
        function frame(now) {
          var p = Math.min(1, (now - t0) / duration);
          drawLine(view, p);
          if (p < 1) {
            requestAnimationFrame(frame);
          } else {
            resolve();
          }
        }
        drawLine(view, 0);
        requestAnimationFrame(frame);
      });
    }

    function start() {
      var rootStyle = getComputedStyle(document.documentElement);
      var inkSoft = rootStyle.getPropertyValue('--ink-soft').trim() || '#4a4a4a';
      var accent = rootStyle.getPropertyValue('--accent').trim() || '#943726';
      var colorHello = inkSoft;
      var colorBrand = accent;
      var colorName = inkSoft;

      loadSegments()
        .then(function () {
          var vHello = buildLine(hello, hello.textContent, colorHello);
          var vBrand = buildLine(brandEl, brandEl.textContent, colorBrand);
          var vName = buildLine(nameEl, nameEl.textContent, colorName);
          return writeLine(vHello, 900)
            .then(function () {
              return delay(140);
            })
            .then(function () {
              return writeLine(vBrand, 1250);
            })
            .then(function () {
              return delay(160);
            })
            .then(function () {
              return writeLine(vName, 1400);
            });
        })
        .then(function () {
          // 全部写完，先让字安安静静展示半秒
          return delay(500);
        })
        .then(beginLand)
        .catch(function () {
          // 笔画数据没取到就退化成静态入场，别把页面卡住
          intro.remove();
          doc.classList.remove('intro-on');
          h1.style.opacity = '1';
          lead.style.opacity = '1';
        });
    }

    // 等字体到位再量位置，最多等 700ms，避免用正楷量、行楷显示
    Promise.race([
      document.fonts ? document.fonts.ready : Promise.resolve(),
      new Promise(function (r) {
        setTimeout(r, 700);
      }),
    ]).then(start);
  })();
</script>
