---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout description={SITE.description}>
  <section class="hero wrap">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/writeups/">开始阅读</a>
      <a class="btn" href="/about/">关于作者</a>
    </div>
  </section>
  <!-- 入场：欢迎语停一下，再「拉近」收成首页的标题与那一行 -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bg"></div>
    <div class="intro-stage">
      <p class="intro-hello">欢迎来到</p>
      <p class="intro-brand" id="introBrand">{SITE.title}</p>
      <p class="intro-name" id="introName">{SITE.description}</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var intro = document.getElementById('intro');
    if (!intro) return;
    var brandEl = document.getElementById('introBrand');
    var nameEl = document.getElementById('introName');
    var hello = intro.querySelector('.intro-hello');
    var bg = intro.querySelector('.intro-bg');
    var h1 = document.querySelector('.hero h1');
    var lead = document.querySelector('.hero .lead');
    var doc = document.documentElement;

    if (!lead || !h1 || !nameEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      intro.remove();
      return;
    }

    // 只在本次进站（同一个标签页会话）第一次打开时播一次；
    // 想在浏览器里再看一遍，地址后面加 ?intro=1 即可
    var KEY = 'shaloworld-intro-seen';
    var replay = /[?&]intro=1(&|$)/.test(location.search);
    var seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch (e) {}
    if (seen && !replay) {
      intro.remove();
      return;
    }
    try {
      sessionStorage.setItem(KEY, '1');
    } catch (e) {}

    intro.style.display = 'grid';
    doc.classList.add('intro-on');
    // 首页的标题与那一行先藏着，等入场的大字落到它们的位置上再换过来
    h1.style.opacity = '0';
    lead.style.opacity = '0';

    function finish() {
      intro.remove();
      doc.classList.remove('intro-on');
    }

    /** 算出「从当前位置缩成目标元素」的位移与比例，原点取文本框中心 */
    function land(el, target) {
      var a = el.getBoundingClientRect();
      var elf = parseFloat(getComputedStyle(el).fontSize);
      var taf = parseFloat(getComputedStyle(target).fontSize);
      var s = Math.min(1, Math.max(0.12, taf / elf));
      var b = target.getBoundingClientRect();
      return {
        scale: s,
        transform:
          'translate(' +
          (b.left - a.left - (a.width - a.width * s) / 2) +
          'px,' +
          (b.top - a.top - (a.height - a.height * s) / 2) +
          'px) scale(' +
          s +
          ')',
      };
    }

    /** 把一行字拆成单个字；词与词之间的空格留成普通空格，窄屏还能正常折行 */
    function splitChars(el) {
      var text = el.textContent;
      var words = text.split(' ');
      var list = [];
      el.textContent = '';
      for (var w = 0; w < words.length; w += 1) {
        if (w > 0) el.appendChild(document.createTextNode(' '));
        for (var i = 0; i < words[w].length; i += 1) {
          var s = document.createElement('span');
          s.className = 'ink-char';
          s.textContent = words[w].charAt(i);
          el.appendChild(s);
          list.push(s);
        }
      }
      return list;
    }

    function delay(ms) {
      return new Promise(function (r) {
        setTimeout(r, ms);
      });
    }

    /** 按 step 的间隔把每个字放出来，像笔尖一字一字落纸 */
    function write(chars, step) {
      return new Promise(function (resolve) {
        var i = 0;
        (function tick() {
          if (i >= chars.length) {
            setTimeout(resolve, step);
            return;
          }
          chars[i].classList.add('is-writing');
          i += 1;
          setTimeout(tick, step);
        })();
      });
    }

    function beginLand() {
      var brandLand = land(brandEl, h1);
      var nameLand = land(nameEl, lead);

      hello.style.opacity = '0';
      hello.style.transform = 'translateY(-10px)';

      var ease = 'transform 1000ms cubic-bezier(.55,.06,.24,1)';
      brandEl.style.transition = ease;
      nameEl.style.transition = ease;
      brandEl.style.transform = brandLand.transform;
      nameEl.style.transform = nameLand.transform;
      bg.style.transition = 'opacity 1000ms ease';
      bg.style.opacity = '0';

      // 位置已经对上，两边交叉淡出换成页面里真正的标题与那一行
      setTimeout(function () {
        brandEl.style.transition = 'opacity 260ms linear';
        nameEl.style.transition = 'opacity 260ms linear';
        brandEl.style.opacity = '0';
        nameEl.style.opacity = '0';
        h1.style.transition = 'opacity 260ms linear';
        lead.style.transition = 'opacity 260ms linear';
        h1.style.opacity = '1';
        lead.style.opacity = '1';
        setTimeout(finish, 280);
      }, 1010);
    }

    /** 沿一行字铺一道五色墨：朱砂 → 赭金 → 墨青 → 雾蓝，像苹果 hello 那样一笔一笔换色 */
    function paintWash(chars) {
      var stops = [
        [148, 55, 38],
        [138, 106, 31],
        [53, 84, 74],
        [63, 92, 138],
      ];
      var n = chars.length;
      for (var i = 0; i < n; i += 1) {
        var p = n > 1 ? i / (n - 1) : 0;
        var seg = p * (stops.length - 1);
        var a = Math.min(stops.length - 1, Math.floor(seg));
        var b = Math.min(stops.length - 1, a + 1);
        var t = seg - a;
        var r = Math.round(stops[a][0] + (stops[b][0] - stops[a][0]) * t);
        var g = Math.round(stops[a][1] + (stops[b][1] - stops[a][1]) * t);
        var bl = Math.round(stops[a][2] + (stops[b][2] - stops[a][2]) * t);
        chars[i].style.color = 'rgb(' + r + ', ' + g + ', ' + bl + ')';
      }
    }

    function start() {
      var helloChars = splitChars(hello);
      var brandChars = splitChars(brandEl);
      var nameChars = splitChars(nameEl);
      paintWash(brandChars);

      write(helloChars, 105)
        .then(function () {
          return delay(150);
        })
        .then(function () {
          return write(brandChars, 90);
        })
        .then(function () {
          return delay(170);
        })
        .then(function () {
          return write(nameChars, 66);
        })
        .then(function () {
          return delay(420);
        })
        .then(beginLand);
    }

    // 等字体到位再量位置，最多等 700ms，避免用正楷量、行楷显示
    Promise.race([
      document.fonts ? document.fonts.ready : Promise.resolve(),
      new Promise(function (r) {
        setTimeout(r, 700);
      }),
    ]).then(start);
  })();
</script>
