---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout description={SITE.description}>
  <section class="hero wrap">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/toc/">开始阅读</a>
      <a class="btn" href="/about/">关于作者</a>
    </div>
  </section>
  <!-- 入场：欢迎语停一下，再「拉近」收成首页的标题与那一行 -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bg"></div>
    <div class="intro-stage">
      <p class="intro-hello">欢迎来到</p>
      <p class="intro-brand" id="introBrand">{SITE.title}</p>
      <p class="intro-name" id="introName">{SITE.description}</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var intro = document.getElementById('intro');
    if (!intro) return;
    var brandEl = document.getElementById('introBrand');
    var nameEl = document.getElementById('introName');
    var hello = intro.querySelector('.intro-hello');
    var bg = intro.querySelector('.intro-bg');
    var h1 = document.querySelector('.hero h1');
    var lead = document.querySelector('.hero .lead');
    var doc = document.documentElement;

    if (!lead || !h1 || !nameEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      intro.remove();
      doc.classList.remove('intro-on');
      return;
    }

    // 只在本次进站（同一个标签页会话）第一次打开时播一次；
    // 想在浏览器里再看一遍，地址后面加 ?intro=1 即可
    var KEY = 'shaloworld-intro-seen';
    var replay = /[?&]intro=1(&|$)/.test(location.search);
    var seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch (e) {}
    if (seen && !replay) {
      intro.remove();
      doc.classList.remove('intro-on');
      return;
    }
    try {
      sessionStorage.setItem(KEY, '1');
    } catch (e) {}

    intro.style.display = 'grid';
    doc.classList.add('intro-on');
    // 首页的标题与那一行先藏着，等入场的大字落到它们的位置上再换过来
    h1.style.opacity = '0';
    lead.style.opacity = '0';

    function finish() {
      intro.remove();
      doc.classList.remove('intro-on');
    }

    /** 算出「从当前位置缩成目标元素」的位移与比例，原点取文本框中心 */
    function land(el, target) {
      var a = el.getBoundingClientRect();
      var elf = parseFloat(getComputedStyle(el).fontSize);
      var taf = parseFloat(getComputedStyle(target).fontSize);
      var s = Math.min(1, Math.max(0.12, taf / elf));
      var b = target.getBoundingClientRect();
      return {
        scale: s,
        transform:
          'translate(' +
          (b.left - a.left - (a.width - a.width * s) / 2) +
          'px,' +
          (b.top - a.top - (a.height - a.height * s) / 2) +
          'px) scale(' +
          s +
          ')',
      };
    }

    function delay(ms) {
      return new Promise(function (r) {
        setTimeout(r, ms);
      });
    }

    function beginLand() {
      var brandLand = land(brandEl, h1);
      var nameLand = land(nameEl, lead);

      hello.style.opacity = '0';
      hello.style.transform = 'translateY(-10px)';

      var ease = 'transform 1000ms cubic-bezier(.55,.06,.24,1)';
      brandEl.style.transition = ease;
      nameEl.style.transition = ease;
      brandEl.style.transform = brandLand.transform;
      nameEl.style.transform = nameLand.transform;

      // 移动的整整一秒里，背景保持不透明，页头和按钮都不出现；
      // 到位后再停半秒，才让整页慢慢浮出来
      setTimeout(revealPage, 1500);
    }

    function revealPage() {
      bg.style.transition = 'opacity 900ms cubic-bezier(.22,.61,.24,1)';
      bg.style.opacity = '0';

      // 页头、页脚和按钮在这一层下面慢慢浮出来；大字先留在原位，
      // 等背景完全透明，再用首页标题和那一行原地换掉，同字同号，看不出切换
      doc.classList.remove('intro-on');
      setTimeout(function () {
        h1.style.transition = 'none';
        lead.style.transition = 'none';
        h1.style.opacity = '1';
        lead.style.opacity = '1';
        finish();
      }, 900);
    }

    /**
     * 入场写字：每一笔都是站点字体本身切出来的一块完整笔画，
     * 按笔顺逐笔推开。底字和最终显示的字同源同形，不会出现
     * 楷体骨架与文楷字形对不上、写到一半只剩零碎边角的问题。
     */
    var SEG = {};
    var segReady = null;

    function loadSegments() {
      if (segReady) return segReady;
      segReady = fetch('/strokes/segments.json')
        .then(function (r) {
          return r.json();
        })
        .then(function (data) {
          var jobs = [];
          Object.keys(data).forEach(function (ch) {
            var list = data[ch].strokes || [];
            list.forEach(function (s) {
              var img = new Image();
              s.img = img;
              jobs.push(
                new Promise(function (res) {
                  img.onload = function () {
                    res();
                  };
                  img.onerror = function () {
                    res();
                  };
                  img.src = s.d;
                })
              );
            });
            SEG[ch] = list;
          });
          return Promise.all(jobs).then(function () {
            return SEG;
          });
        });
      return segReady;
    }

    /** 拼出 canvas / document.fonts 都能用的字体简写 */
    function fontSpec(el) {
      var style = getComputedStyle(el);
      return (
        (style.fontStyle && style.fontStyle !== 'normal' ? style.fontStyle + ' ' : '') +
        (style.fontWeight || '400') +
        ' ' +
        style.fontSize +
        ' ' +
        style.fontFamily
      );
    }

    function buildLine(el, text, color) {
      var rect = el.getBoundingClientRect();
      var style = getComputedStyle(el);
      var size = parseFloat(style.fontSize);
      var ls = parseFloat(style.letterSpacing) || 0;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var font = fontSpec(el);

      // 画布四周留余量，字形的起笔、捺脚和字母外伸都画得下
      var pad = Math.max(8, Math.round(size * 0.36));
      var cvs = document.createElement('canvas');
      cvs.width = Math.max(1, Math.round((rect.width + pad * 2) * dpr));
      cvs.height = Math.max(1, Math.round((rect.height + pad * 2) * dpr));
      cvs.style.cssText =
        'position:absolute;left:' +
        -pad +
        'px;top:' +
        -pad +
        'px;width:' +
        (rect.width + pad * 2) +
        'px;height:' +
        (rect.height + pad * 2) +
        'px;pointer-events:none;letter-spacing:0;word-spacing:0;';
      el.style.position = 'relative';
      el.appendChild(cvs);

      var ctx = cvs.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.textBaseline = 'alphabetic';
      ctx.font = font;
      // 画布挂在带 letter-spacing 的标题里，这层 CSS 会被画布继承，
      // 导致 measureText 每个字都多算一份字距；这里清零，字距由下面手动排
      if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';

      // 同尺寸的遮罩画布：每一帧把已经写到的笔画画进来，
      // 再用它把整行字裁出来，所以笔画边缘、粗细始终和页面字体一致
      var mask = document.createElement('canvas');
      mask.width = cvs.width;
      mask.height = cvs.height;
      var mctx = mask.getContext('2d');
      mctx.scale(dpr, dpr);

      var met = ctx.measureText(text);
      var asc = met.fontBoundingBoxAscent || size * 0.82;
      var desc = met.fontBoundingBoxDescent || size * 0.22;
      var baseline = pad + (rect.height - (asc + desc)) / 2 + asc;

      // 逐字排版；letter-spacing 在最后一个字后面也留一份
      var glyphs = [];
      var totalW = 0;
      for (var i = 0; i < text.length; i += 1) {
        var ch = text.charAt(i);
        var w = ctx.measureText(ch).width;
        totalW += w + ls;
        glyphs.push({ ch: ch, w: w, space: ch === ' ' });
      }
      var startX = pad + (rect.width - totalW) / 2;
      var penX = startX;
      for (var g = 0; g < glyphs.length; g += 1) {
        glyphs[g].x = penX;
        penX += glyphs[g].w + ls;
      }
      // 笔画块是 1000 单位字身框里的坐标，按字号缩放后贴到基线位置
      var scale = size / 1000;
      var strokes = [];
      glyphs.forEach(function (gl) {
        if (gl.space) return;
        var list = SEG[gl.ch] || [];
        list.forEach(function (s) {
          if (!s.img || !s.img.naturalWidth) return;
          var sw = Math.max(0.1, (s.x1 - s.x0) * scale);
          var sh = Math.max(0.1, (s.y1 - s.y0) * scale);
          var sx = gl.x + s.x0 * scale;
          var sy = baseline - s.y1 * scale;
          var latin = gl.ch.charCodeAt(0) < 128;
          var pts = (s.pts || []).map(function (p) {
            return [gl.x + p[0] * scale, baseline - p[1] * scale];
          });
          strokes.push({
            img: s.img,
            x: sx,
            y: sy,
            w: sw,
            h: sh,
            wt: Math.max(40, s.wt || 100),
            pts: pts,
            r: latin ? Math.max(2.4, size * 0.12) : Math.max(3.2, size * 0.19),
          });
        });
      });

      // 让每一笔至少占整行 2.5% 的时间，短点、短横也看得见
      var raw = 0;
      strokes.forEach(function (s) {
        raw += s.wt;
      });
      var floor = raw * 0.025;
      var total = 0;
      strokes.forEach(function (s) {
        if (s.wt < floor) s.wt = floor;
        s.start = total;
        total += s.wt;
      });

      return {
        ctx: ctx,
        cvs: cvs,
        el: el,
        mask: mask,
        mctx: mctx,
        w: rect.width + pad * 2,
        h: rect.height + pad * 2,
        font: font,
        color: color,
        baseline: baseline,
        glyphs: glyphs,
        strokes: strokes,
        total: total || 1,
      };
    }

    /** 把整行字用页面同款字体画出来，遮罩只决定此刻露出哪些笔画 */
    function paintText(view) {
      var ctx = view.ctx;
      ctx.font = view.font;
      if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
      ctx.fillStyle = view.color;
      ctx.textBaseline = 'alphabetic';
      for (var i = 0; i < view.glyphs.length; i += 1) {
        var gl = view.glyphs[i];
        if (!gl.space) ctx.fillText(gl.ch, gl.x, view.baseline);
      }
    }

    /** 这一笔写到 q（0~1）：沿笔迹路径推进，只露出这一块笔画 */
    function drawStrokeMask(view, s, q) {
      var mctx = view.mctx;
      var pts = s.pts || [];
      if (q >= 1) {
        mctx.drawImage(s.img, s.x, s.y, s.w, s.h);
        return;
      }
      if (pts.length < 2) {
        // 单点笔画（点、短横）画一个小圆口
        mctx.save();
        mctx.beginPath();
        mctx.arc(s.x + s.w / 2, s.y + s.h / 2, Math.max(s.r, 2), 0, Math.PI * 2);
        mctx.clip();
        mctx.drawImage(s.img, s.x, s.y, s.w, s.h);
        mctx.restore();
        return;
      }

      // 取路径前 q 段，并保留最后一个插值点
      var lens = [];
      var total = 0;
      for (var i = 1; i < pts.length; i += 1) {
        var d = Math.sqrt(
          (pts[i][0] - pts[i - 1][0]) * (pts[i][0] - pts[i - 1][0]) +
            (pts[i][1] - pts[i - 1][1]) * (pts[i][1] - pts[i - 1][1])
        );
        lens.push(d);
        total += d;
      }
      var target = q * total;
      var prefix = [pts[0]];
      var acc = 0;
      for (var j = 0; j < lens.length; j += 1) {
        if (acc + lens[j] <= target) {
          acc += lens[j];
          prefix.push(pts[j + 1]);
        } else {
          var t = lens[j] > 0 ? (target - acc) / lens[j] : 1;
          prefix.push([
            pts[j][0] + (pts[j + 1][0] - pts[j][0]) * t,
            pts[j][1] + (pts[j + 1][1] - pts[j][1]) * t,
          ]);
          break;
        }
      }

      // 以笔迹为轴，铺一条和笔画同宽的通道，只裁出通道里的字形像素
      var left = [];
      var right = [];
      for (var k = 0; k < prefix.length; k += 1) {
        var ax;
        var ay;
        if (k === 0) {
          ax = prefix[1][0] - prefix[0][0];
          ay = prefix[1][1] - prefix[0][1];
        } else if (k === prefix.length - 1) {
          ax = prefix[k][0] - prefix[k - 1][0];
          ay = prefix[k][1] - prefix[k - 1][1];
        } else {
          ax = prefix[k + 1][0] - prefix[k - 1][0];
          ay = prefix[k + 1][1] - prefix[k - 1][1];
        }
        var m = Math.sqrt(ax * ax + ay * ay) || 1;
        var nx = (-ay / m) * s.r;
        var ny = (ax / m) * s.r;
        left.push([prefix[k][0] + nx, prefix[k][1] + ny]);
        right.push([prefix[k][0] - nx, prefix[k][1] - ny]);
      }

      mctx.save();
      mctx.beginPath();
      mctx.moveTo(left[0][0], left[0][1]);
      for (var a = 1; a < left.length; a += 1) mctx.lineTo(left[a][0], left[a][1]);
      for (var b = right.length - 1; b >= 0; b -= 1) mctx.lineTo(right[b][0], right[b][1]);
      mctx.closePath();
      mctx.clip();
      mctx.drawImage(s.img, s.x, s.y, s.w, s.h);
      mctx.restore();

      // 收笔前把这条笔画的边角轻轻补满，避免末端突然跳出来
      if (q > 0.85) {
        mctx.save();
        mctx.globalAlpha = (q - 0.85) / 0.15;
        mctx.drawImage(s.img, s.x, s.y, s.w, s.h);
        mctx.restore();
      }
    }

    /** p 从 0 到 1：按笔顺把这一行写完 */
    function drawLine(view, p) {
      var ctx = view.ctx;
      ctx.clearRect(0, 0, view.w, view.h);
      paintText(view);

      if (p >= 1) return;

      var mctx = view.mctx;
      mctx.clearRect(0, 0, view.w, view.h);
      var vis = p * view.total;
      for (var i = 0; i < view.strokes.length; i += 1) {
        var s = view.strokes[i];
        if (vis <= s.start) break;
        var q = Math.min(1, (vis - s.start) / s.wt);
        drawStrokeMask(view, s, q);
      }

      ctx.globalCompositeOperation = 'destination-in';
      ctx.drawImage(view.mask, 0, 0, view.w, view.h);
      ctx.globalCompositeOperation = 'source-over';
    }

    /** 一行在 duration 毫秒内按笔顺写完 */
    function writeLine(view, duration) {
      return new Promise(function (resolve) {
        var t0 = performance.now();
        function frame(now) {
          var p = Math.min(1, (now - t0) / duration);
          drawLine(view, p);
          if (p < 1) {
            requestAnimationFrame(frame);
          } else {
            resolve();
          }
        }
        drawLine(view, 0);
        requestAnimationFrame(frame);
      });
    }

    function start() {
      var rootStyle = getComputedStyle(document.documentElement);
      var inkSoft = rootStyle.getPropertyValue('--ink-soft').trim() || '#4a4a4a';
      var accent = rootStyle.getPropertyValue('--accent').trim() || '#943726';

      // 入场文字在 CSS 里是透明的，浏览器可能不去加载对应的文楷分片，
      // 画布就会退回系统字体，和笔画遮罩对不上。按行分别预加载：
      // 欢迎语先写，品牌和名字的字体在它书写时并行加载
      function loadFont(el) {
        if (!document.fonts || !document.fonts.load) return Promise.resolve();
        return document.fonts.load(fontSpec(el), el.textContent).catch(function () {});
      }

      // 字体到齐后浏览器还要重排一次，等两帧再量宽高
      function settle() {
        return new Promise(function (resolve) {
          requestAnimationFrame(function () {
            requestAnimationFrame(resolve);
          });
        });
      }

      var segmentsReady = loadSegments();
      var helloFont = loadFont(hello);
      var brandFont = loadFont(brandEl);
      var nameFont = loadFont(nameEl);

      helloFont
        .then(settle)
        .then(function () {
          return segmentsReady;
        })
        .then(function () {
          var vHello = buildLine(hello, hello.textContent, inkSoft);
          return writeLine(vHello, 900).then(function () {
            return delay(140);
          });
        })
        .then(function () {
          return brandFont.then(settle);
        })
        .then(function () {
          var vBrand = buildLine(brandEl, brandEl.textContent, accent);
          return writeLine(vBrand, 1200).then(function () {
            return delay(160);
          });
        })
        .then(function () {
          return nameFont.then(settle);
        })
        .then(function () {
          var vName = buildLine(nameEl, nameEl.textContent, inkSoft);
          return writeLine(vName, 1500);
        })
        .then(function () {
          // 全部写完，先让字安安静静展示半秒
          return delay(500);
        })
        .then(beginLand)
        .catch(function () {
          // 笔画数据没取到就退化成静态入场，别把页面卡住
          intro.remove();
          doc.classList.remove('intro-on');
          h1.style.opacity = '1';
          lead.style.opacity = '1';
        });
    }

    // 字体在 start 内按行加载，这里直接开场，避免等待 document.fonts.ready 白屏
    start();
  })();
</script>
