---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout description={SITE.description}>
  <section class="hero wrap">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/writeups/">开始阅读</a>
      <a class="btn" href="/about/">关于作者</a>
    </div>
  </section>
  <!-- 入场：欢迎语停一下，再「拉近」收成首页的标题与那一行 -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bg"></div>
    <div class="intro-stage">
      <p class="intro-hello">欢迎来到</p>
      <p class="intro-brand" id="introBrand">{SITE.title}</p>
      <p class="intro-name" id="introName">{SITE.description}</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var intro = document.getElementById('intro');
    if (!intro) return;
    var brandEl = document.getElementById('introBrand');
    var nameEl = document.getElementById('introName');
    var hello = intro.querySelector('.intro-hello');
    var bg = intro.querySelector('.intro-bg');
    var h1 = document.querySelector('.hero h1');
    var lead = document.querySelector('.hero .lead');
    var doc = document.documentElement;

    if (!lead || !h1 || !nameEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      intro.remove();
      doc.classList.remove('intro-on');
      return;
    }

    // 只在本次进站（同一个标签页会话）第一次打开时播一次；
    // 想在浏览器里再看一遍，地址后面加 ?intro=1 即可
    var KEY = 'shaloworld-intro-seen';
    var replay = /[?&]intro=1(&|$)/.test(location.search);
    var seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch (e) {}
    if (seen && !replay) {
      intro.remove();
      doc.classList.remove('intro-on');
      return;
    }
    try {
      sessionStorage.setItem(KEY, '1');
    } catch (e) {}

    intro.style.display = 'grid';
    doc.classList.add('intro-on');
    // 首页的标题与那一行先藏着，等入场的大字落到它们的位置上再换过来
    h1.style.opacity = '0';
    lead.style.opacity = '0';

    function finish() {
      intro.remove();
      doc.classList.remove('intro-on');
    }

    /** 算出「从当前位置缩成目标元素」的位移与比例，原点取文本框中心 */
    function land(el, target) {
      var a = el.getBoundingClientRect();
      var elf = parseFloat(getComputedStyle(el).fontSize);
      var taf = parseFloat(getComputedStyle(target).fontSize);
      var s = Math.min(1, Math.max(0.12, taf / elf));
      var b = target.getBoundingClientRect();
      return {
        scale: s,
        transform:
          'translate(' +
          (b.left - a.left - (a.width - a.width * s) / 2) +
          'px,' +
          (b.top - a.top - (a.height - a.height * s) / 2) +
          'px) scale(' +
          s +
          ')',
      };
    }

    function delay(ms) {
      return new Promise(function (r) {
        setTimeout(r, ms);
      });
    }

    function beginLand() {
      var brandLand = land(brandEl, h1);
      var nameLand = land(nameEl, lead);

      hello.style.opacity = '0';
      hello.style.transform = 'translateY(-10px)';

      var ease = 'transform 1000ms cubic-bezier(.55,.06,.24,1)';
      brandEl.style.transition = ease;
      nameEl.style.transition = ease;
      brandEl.style.transform = brandLand.transform;
      nameEl.style.transform = nameLand.transform;

      // 移动的整整一秒里，背景保持不透明，页头和按钮都不出现；
      // 到位后再停半秒，才让整页慢慢浮出来
      setTimeout(revealPage, 1500);
    }

    function revealPage() {
      bg.style.transition = 'opacity 900ms cubic-bezier(.22,.61,.24,1)';
      bg.style.opacity = '0';

      brandEl.style.transition = 'opacity 320ms linear';
      nameEl.style.transition = 'opacity 320ms linear';
      brandEl.style.opacity = '0';
      nameEl.style.opacity = '0';

      h1.style.transition = 'opacity 620ms cubic-bezier(.22,.61,.24,1)';
      lead.style.transition = 'opacity 620ms cubic-bezier(.22,.61,.24,1)';
      h1.style.opacity = '1';
      lead.style.opacity = '1';

      doc.classList.remove('intro-on');
      setTimeout(finish, 980);
    }

    /**
     * 入场写字：不再让整字淡入，而是按笔顺一笔一笔描出来。
     * 中文用笔画中线数据，拉丁字母用手写的单线笔迹；
     * 每一笔从起笔到收笔沿中线推进，落笔顺序和真实写字一致。
     */
    var STROKE_FILES = {
      欢: 'huan',
      迎: 'ying',
      来: 'lai',
      到: 'dao',
      的: 'de',
      小: 'xiao',
      世: 'shi',
      界: 'jie',
    };

    // 拉丁字母的单线笔迹：w 是字宽（em），strokes 是每一笔的归一化坐标（0~1）
    var LATIN = {
      S: { w: 0.56, strokes: [[[0.55, 0.12], [0.4, 0.05], [0.22, 0.12], [0.15, 0.3], [0.24, 0.46], [0.4, 0.54], [0.48, 0.66], [0.44, 0.84], [0.28, 0.93], [0.1, 0.9]]] },
      h: { w: 0.54, strokes: [[[0.2, 0.04], [0.2, 0.96]], [[0.2, 0.44], [0.34, 0.34], [0.46, 0.42], [0.46, 0.96]]] },
      a: { w: 0.54, strokes: [[[0.46, 0.42], [0.28, 0.38], [0.15, 0.56], [0.22, 0.82], [0.38, 0.94], [0.48, 0.8], [0.47, 0.42]], [[0.47, 0.96], [0.47, 0.42]]] },
      l: { w: 0.34, strokes: [[[0.26, 0.04], [0.26, 0.9], [0.42, 0.98]]] },
      o: { w: 0.56, strokes: [[[0.32, 0.42], [0.16, 0.56], [0.2, 0.8], [0.38, 0.94], [0.5, 0.78], [0.44, 0.46], [0.32, 0.42]]] },
      w: { w: 0.76, strokes: [[[0.05, 0.42], [0.22, 0.96], [0.38, 0.58], [0.55, 0.96], [0.72, 0.42]]] },
      r: { w: 0.4, strokes: [[[0.18, 0.42], [0.18, 0.96]], [[0.18, 0.54], [0.3, 0.38], [0.42, 0.42]]] },
      d: { w: 0.56, strokes: [[[0.47, 0.04], [0.47, 0.96]], [[0.46, 0.42], [0.28, 0.38], [0.15, 0.56], [0.22, 0.82], [0.38, 0.94], [0.48, 0.8], [0.47, 0.42]]] },
      t: { w: 0.44, strokes: [[[0.26, 0.06], [0.26, 0.84], [0.42, 0.96]], [[0.1, 0.4], [0.42, 0.4]]] },
    };

    function loadStrokes() {
      var chars = Object.keys(STROKE_FILES);
      return Promise.all(
        chars.map(function (ch) {
          return fetch('/strokes/' + STROKE_FILES[ch] + '.json')
            .then(function (r) {
              return r.json();
            })
            .then(function (data) {
              strokeData[ch] = { medians: data.medians, strokes: data.strokes };
            });
        })
      );
    }
    var strokeData = {};

    function segLen(a, b) {
      var dx = b[0] - a[0];
      var dy = b[1] - a[1];
      return Math.sqrt(dx * dx + dy * dy);
    }

    /** 把手写的折线点串成顺滑曲线，避免字形一节一节的 */
    function smoothPts(pts) {
      if (pts.length < 3) return pts;
      var out = [];
      for (var i = 0; i < pts.length - 1; i += 1) {
        var p0 = pts[i - 1] || pts[i];
        var p1 = pts[i];
        var p2 = pts[i + 1];
        var p3 = pts[i + 2] || p2;
        for (var j = 0; j < 7; j += 1) {
          var t = j / 7;
          var t2 = t * t;
          var t3 = t2 * t;
          out.push([
            0.5 * (2 * p1[0] + (-p0[0] + p2[0]) * t + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t2 + (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t3),
            0.5 * (2 * p1[1] + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3),
          ]);
        }
      }
      out.push(pts[pts.length - 1]);
      return out;
    }

    /** 把折线按固定步长重新采样，笔刷沿这些点一路盖过去 */
    function addPolyline(pts, step, acc) {
      if (!pts || !pts.length) return;
      acc.points.push({ x: pts[0][0], y: pts[0][1], cum: acc.len });
      for (var i = 1; i < pts.length; i += 1) {
        var a = pts[i - 1];
        var b = pts[i];
        var d = segLen(a, b);
        if (d <= 0) continue;
        var n = Math.max(1, Math.round(d / step));
        for (var j = 1; j <= n; j += 1) {
          var t = j / n;
          acc.len += d / n;
          acc.points.push({
            x: a[0] + (b[0] - a[0]) * t,
            y: a[1] + (b[1] - a[1]) * t,
            cum: acc.len,
          });
        }
      }
    }

    /**
     * 一行字照着最终字体原样画在 canvas 上，
     * 再用一层慢慢铺开的软笔刷当作遮罩：遮罩走到哪里，字就露到哪里。
     * 因为底字就是站点字体，写完不会换字形、换字号，也不会突然跳一下。
     */
    function buildLine(el, text, color) {
      var rect = el.getBoundingClientRect();
      var style = getComputedStyle(el);
      var size = parseFloat(style.fontSize);
      var ls = parseFloat(style.letterSpacing) || 0;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var font =
        (style.fontStyle && style.fontStyle !== 'normal' ? style.fontStyle + ' ' : '') +
        (style.fontWeight || '400') +
        ' ' +
        style.fontSize +
        ' ' +
        style.fontFamily;

      var cvs = document.createElement('canvas');
      cvs.width = Math.max(1, Math.round(rect.width * dpr));
      cvs.height = Math.max(1, Math.round(rect.height * dpr));
      cvs.style.cssText =
        'position:absolute;left:0;top:0;width:' + rect.width + 'px;height:' + rect.height + 'px;pointer-events:none;';
      el.style.position = 'relative';
      el.appendChild(cvs);

      var ctx = cvs.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.textBaseline = 'alphabetic';
      ctx.font = font;

      var mask = document.createElement('canvas');
      mask.width = cvs.width;
      mask.height = cvs.height;
      var mctx = mask.getContext('2d');
      mctx.scale(dpr, dpr);

      var met = ctx.measureText(text);
      var asc = met.fontBoundingBoxAscent || size * 0.82;
      var desc = met.fontBoundingBoxDescent || size * 0.22;
      var baseline = (rect.height - (asc + desc)) / 2 + asc;

      // 逐字排版，位置与 CSS 的行内字距保持一致
      var glyphs = [];
      var widths = [];
      var totalW = 0;
      for (var i = 0; i < text.length; i += 1) {
        var ch = text.charAt(i);
        var w = ctx.measureText(ch).width;
        widths.push(w);
        totalW += w + (i < text.length - 1 ? ls : 0);
        glyphs.push({ ch: ch, w: w, space: ch === ' ' });
      }
      var startX = (rect.width - totalW) / 2;
      var penX = startX;
      for (var g = 0; g < glyphs.length; g += 1) {
        glyphs[g].x = penX;
        penX += glyphs[g].w + (g < glyphs.length - 1 ? ls : 0);
      }

      // 笔刷半径略大于字符笔画，经过时能把整个笔画润开
      var radius = Math.max(3, size * 0.18);
      var step = Math.max(1, radius * 0.22);
      var acc = { points: [], len: 0 };

      glyphs.forEach(function (gl) {
        if (gl.space) return;
        var mm = ctx.measureText(gl.ch);
        var left = gl.x - (mm.actualBoundingBoxLeft || 0);
        var right = gl.x + (mm.actualBoundingBoxRight || gl.w);
        var top = baseline - (mm.actualBoundingBoxAscent || size * 0.78);
        var bottom = baseline + (mm.actualBoundingBoxDescent || size * 0.12);
        var boxW = Math.max(1, right - left);
        var boxH = Math.max(1, bottom - top);

        if (LATIN[gl.ch]) {
          LATIN[gl.ch].strokes.forEach(function (raw) {
            var pts = smoothPts(
              raw.map(function (q) {
                return [left + q[0] * boxW, top + q[1] * boxH];
              })
            );
            addPolyline(pts, step, acc);
          });
        } else if (strokeData[gl.ch]) {
          strokeData[gl.ch].medians.forEach(function (raw) {
            var pts = raw.map(function (q) {
              return [left + (q[0] / 1024) * boxW, top + ((1024 - q[1]) / 1024) * boxH];
            });
            addPolyline(pts, step, acc);
          });
        }
      });

      // 一枚软边圆笔刷，反复盖章叠成一条有浓淡的墨迹
      var brush = document.createElement('canvas');
      brush.width = 64;
      brush.height = 64;
      var bctx = brush.getContext('2d');
      var grad = bctx.createRadialGradient(32, 32, 3, 32, 32, 32);
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.42, 'rgba(255,255,255,0.96)');
      grad.addColorStop(0.72, 'rgba(255,255,255,0.5)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      bctx.fillStyle = grad;
      bctx.fillRect(0, 0, 64, 64);

      return {
        ctx: ctx,
        mctx: mctx,
        mask: mask,
        w: rect.width,
        h: rect.height,
        font: font,
        color: color,
        baseline: baseline,
        glyphs: glyphs,
        points: acc.points,
        total: acc.len || 1,
        radius: radius,
        brush: brush,
        painted: 0,
      };
    }

    /** 用最终字体把整行字画出来，遮罩只决定这一刻露多少 */
    function paintGlyphs(view, target, color) {
      target.save();
      target.font = view.font;
      target.fillStyle = color;
      target.textBaseline = 'alphabetic';
      for (var i = 0; i < view.glyphs.length; i += 1) {
        var gl = view.glyphs[i];
        if (!gl.space) target.fillText(gl.ch, gl.x, view.baseline);
      }
      target.restore();
    }

    /** p 从 0 到 1：笔刷铺到哪儿，字就露到哪儿 */
    function drawLine(view, p) {
      var target = p * view.total;
      var r = view.radius;
      while (view.painted < view.points.length) {
        var pt = view.points[view.painted];
        if (pt.cum > target) break;
        view.mctx.drawImage(view.brush, pt.x - r, pt.y - r, r * 2, r * 2);
        view.painted += 1;
      }

      // 最后一段让整行淡淡地补全，避免个别边角在收笔时突然跳出来
      if (p > 0.86) {
        view.mctx.save();
        view.mctx.globalAlpha = (p - 0.86) / 0.14;
        paintGlyphs(view, view.mctx, '#fff');
        view.mctx.restore();
      }

      view.ctx.clearRect(0, 0, view.w, view.h);
      paintGlyphs(view, view.ctx, view.color);
      view.ctx.globalCompositeOperation = 'destination-in';
      view.ctx.drawImage(view.mask, 0, 0, view.w, view.h);
      view.ctx.globalCompositeOperation = 'source-over';
    }

    /** 一行在 duration 毫秒内按笔顺写完 */
    function writeLine(view, duration) {
      return new Promise(function (resolve) {
        var t0 = performance.now();
        function frame(now) {
          var p = Math.min(1, (now - t0) / duration);
          drawLine(view, p);
          if (p < 1) {
            requestAnimationFrame(frame);
          } else {
            resolve();
          }
        }
        drawLine(view, 0);
        requestAnimationFrame(frame);
      });
    }

    function start() {
      var rootStyle = getComputedStyle(document.documentElement);
      var inkSoft = rootStyle.getPropertyValue('--ink-soft').trim() || '#4a4a4a';
      var accent = rootStyle.getPropertyValue('--accent').trim() || '#943726';
      var colorHello = inkSoft;
      var colorBrand = accent;
      var colorName = inkSoft;

      loadStrokes()
        .then(function () {
          var vHello = buildLine(hello, hello.textContent, colorHello);
          var vBrand = buildLine(brandEl, brandEl.textContent, colorBrand);
          var vName = buildLine(nameEl, nameEl.textContent, colorName);
          return writeLine(vHello, 900)
            .then(function () {
              return delay(140);
            })
            .then(function () {
              return writeLine(vBrand, 1250);
            })
            .then(function () {
              return delay(160);
            })
            .then(function () {
              return writeLine(vName, 1400);
            });
        })
        .then(function () {
          // 全部写完，先让字安安静静展示半秒
          return delay(500);
        })
        .then(beginLand)
        .catch(function () {
          // 笔画数据没取到就退化成静态入场，别把页面卡住
          intro.remove();
          doc.classList.remove('intro-on');
          h1.style.opacity = '1';
          lead.style.opacity = '1';
        });
    }

    // 等字体到位再量位置，最多等 700ms，避免用正楷量、行楷显示
    Promise.race([
      document.fonts ? document.fonts.ready : Promise.resolve(),
      new Promise(function (r) {
        setTimeout(r, 700);
      }),
    ]).then(start);
  })();
</script>
