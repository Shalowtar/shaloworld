---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout description={SITE.description}>
  <section class="hero wrap">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/writeups/">开始阅读</a>
      <a class="btn" href="/about/">关于作者</a>
    </div>
  </section>
  <!-- 入场：欢迎语先占满画面，再「拉近」收成首页那一行 -->
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bg"></div>
    <div class="intro-stage">
      <p class="intro-hello">欢迎来到</p>
      <p class="intro-name" id="introName">{SITE.description}</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var intro = document.getElementById('intro');
    if (!intro) return;
    var nameEl = document.getElementById('introName');
    var hello = intro.querySelector('.intro-hello');
    var bg = intro.querySelector('.intro-bg');
    var lead = document.querySelector('.hero .lead');
    var doc = document.documentElement;

    if (!lead || !nameEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      intro.remove();
      return;
    }

    intro.style.display = 'grid';
    doc.classList.add('intro-on');
    // 首页那一行先藏着，等欢迎语正好落在它上面再换过来
    lead.style.opacity = '0';

    function finish() {
      intro.remove();
      doc.classList.remove('intro-on');
    }

    function start() {
      var a = nameEl.getBoundingClientRect();
      var nameFs = parseFloat(getComputedStyle(nameEl).fontSize);
      var leadFs = parseFloat(getComputedStyle(lead).fontSize);
      var s = Math.min(1, Math.max(0.12, leadFs / nameFs));
      var b = lead.getBoundingClientRect();

      // 收进首页后，缩放后的文本框要贴住首页那一行
      var dx = b.left - a.left - (a.width - a.width * s) / 2;
      var dy = b.top - a.top - (a.height - a.height * s) / 2;

      // 先往前推一点，像镜头压近
      nameEl.style.transition = 'transform 560ms cubic-bezier(.3,.72,.3,1)';
      nameEl.style.transform = 'scale(1.1)';
      hello.style.opacity = '0';
      hello.style.transform = 'translateY(-8px)';

      setTimeout(function () {
        // 再把整句收成首页那一行，同时揭开页面（页脚以下的内容从纸后面浮出来）
        nameEl.style.transition = 'transform 780ms cubic-bezier(.55,.06,.24,1)';
        nameEl.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(' + s + ')';
        bg.style.transition = 'opacity 680ms ease';
        bg.style.opacity = '0';

        setTimeout(function () {
          // 位置已经对上，两边交叉淡出换成页面里真正的那一行
          nameEl.style.transition = 'opacity 240ms linear';
          nameEl.style.opacity = '0';
          lead.style.transition = 'opacity 240ms linear';
          lead.style.opacity = '1';
          setTimeout(finish, 260);
        }, 770);
      }, 600);
    }

    // 等字体到位再量位置，最多等 600ms，避免用正楷量、行楷显示
    Promise.race([
      document.fonts ? document.fonts.ready : Promise.resolve(),
      new Promise(function (r) {
        setTimeout(r, 600);
      }),
    ]).then(start);
  })();
</script>
