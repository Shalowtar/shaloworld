---
import Breadcrumb from '../../components/Breadcrumb.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmallToc from '../../components/SmallToc.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES, SITE } from '../../consts';
import {
  visiblePosts,
  formatDate,
  formatDateCN,
  readingTime,
  relatedPosts,
} from '../../utils/posts';
import type { TocGroup } from '../../utils/toc';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('writeups'));
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;

const all = visiblePosts(await getCollection('writeups'));
const index = all.findIndex((p) => p.id === post.id);
const prev = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
const related = relatedPosts(post, all, 3);

const crumbs = [
  { label: 'articles', href: '/writeups/' },
  {
    label: data.category,
    href: `/writeups/?cat=${encodeURIComponent(data.category)}`,
    cat: data.category,
  },
  ...(data.event
    ? [
        {
          label: data.event,
          href: `/writeups/?cat=${encodeURIComponent(data.category)}&event=${encodeURIComponent(data.event)}`,
        },
      ]
    : []),
];

/** 文章目录：只放当前分区的分类，分类下再收文章与章节 */
const outlines: {
  id: string;
  title: string;
  category: string;
  current: boolean;
  headings: { depth: number; slug: string; text: string; href?: string }[];
}[] = [];
for (const p of all) {
  const isCurrent = p.id === post.id;
  const outline = isCurrent ? headings : (await render(p)).headings;
  outlines.push({
    id: p.id,
    title: p.data.title,
    category: p.data.category,
    current: isCurrent,
    headings: outline
      .filter((h) => h.depth === 2 || h.depth === 3)
      .map((h) => ({
        depth: h.depth,
        slug: h.slug,
        text: h.text,
        href: isCurrent ? `#${h.slug}` : `/writeups/${p.id}/#${h.slug}`,
      })),
  });
}

const tocGroups: TocGroup[] = CATEGORIES.map((category) => {
  const list = outlines.filter((o) => o.category === category);
  if (!list.length) return null;
  return {
    name: category,
    href: `/writeups/?cat=${encodeURIComponent(category)}`,
    meta: `${list.length}`,
    current: category === data.category,
    children: list.map((o) => ({
      name: o.title,
      href: o.current ? '#top' : `/writeups/${o.id}/`,
      current: o.current,
      headings: o.headings,
    })),
  };
}).filter((group): group is TocGroup => group !== null);
const minutes = readingTime(post.body);
const description = data.summary;

const siteUrl = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const shareTitle = `${data.title} · ${SITE.title}`;
const shareText = data.summary;

/** JSON 里的 `<` 转义成 \u003c，正文出现 </script> 也不会顶断结构化数据标签 */
const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');

/** 文章级结构化数据：搜索引擎与分享卡片能读到标题、日期、分类、标签 */
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.summary,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  inLanguage: 'zh-CN',
  articleSection: data.category,
  keywords: data.tags.join(', '),
  author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  publisher: { '@type': 'Organization', name: SITE.title, url: siteUrl.href },
};
---

<BaseLayout title={data.title} description={description} type="article" publishedAt={data.publishedAt}>
  <script slot="head" type="application/ld+json" set:html={jsonLd(articleSchema)} />
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <div class="wrap reading-page">
    <section class="article-top">
      <Breadcrumb segments={crumbs} />

      <div class="article-badges">
        <span class="badge" data-cat={data.category}>{data.category}</span>
        {data.difficulty && <span class="badge" data-diff={data.difficulty}>{data.difficulty}</span>}
        {data.event && <span class="badge">{data.event}</span>}
      </div>

      <h1>{data.title}</h1>

      {
        data.tags.length > 0 && (
          <div class="title-tags" aria-label="文章标签">
            {data.tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))}
          </div>
        )
      }

      <p class="standfirst">{data.summary}</p>

      <div class="article-meta">
        <span>发布于 {formatDate(data.publishedAt)}</span>
        {data.updatedAt && <span>更新 {formatDate(data.updatedAt)}</span>}
        <span>{minutes} min 阅读</span>
        {data.solveTime && <span>解题 {data.solveTime}</span>}
        {data.tools.length > 0 && <span>工具 {data.tools.join(' / ')}</span>}
        <div class="share-wrap">
          <button class="share-btn" id="share-btn" type="button" aria-expanded="false" aria-controls="share-menu">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <path d="M8.6 10.5 15.4 6.5M8.6 13.5l6.8 4"></path>
            </svg>
            <span>分享</span>
          </button>
          <div class="share-menu" id="share-menu" hidden>
            <div class="share-menu-head">
              <span class="share-kicker">SHARE</span>
              <span class="share-menu-title">分享这篇文章</span>
            </div>
            <button class="share-item" type="button" data-share="copy">
              <span class="share-index">01</span>
              <span class="share-name">复制链接</span>
              <span class="share-tail">LINK</span>
            </button>
            <button class="share-item" type="button" data-share="wechat">
              <span class="share-index">02</span>
              <span class="share-name">微信</span>
              <span class="share-tail">复制后粘贴</span>
            </button>
            <a class="share-item" href={`https://service.weibo.com/share/share.php?url=${encodeURIComponent(canonical)}&title=${encodeURIComponent(shareTitle)}`} target="_blank" rel="noopener noreferrer">
              <span class="share-index">03</span>
              <span class="share-name">微博</span>
              <span class="share-tail">WEIBO ↗</span>
            </a>
            <a class="share-item" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(shareTitle)}`} target="_blank" rel="noopener noreferrer">
              <span class="share-index">04</span>
              <span class="share-name">X / Twitter</span>
              <span class="share-tail">POST ↗</span>
            </a>
            <a class="share-item" href={`https://t.me/share/url?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(shareTitle)}`} target="_blank" rel="noopener noreferrer">
              <span class="share-index">05</span>
              <span class="share-name">Telegram</span>
              <span class="share-tail">SEND ↗</span>
            </a>
            <button class="share-item" type="button" data-share="native" hidden>
              <span class="share-index">06</span>
              <span class="share-name">系统分享</span>
              <span class="share-tail">SYSTEM</span>
            </button>
            <p class="share-status" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </section>

    <div class="article-grid">
      <article class="prose" id="article">
        <Content />

        {
          data.attachments.length > 0 && (
            <div class="attachments">
              <div class="attachments-head">附件 / attachments</div>
              <ul>
                {data.attachments.map((a) => (
                  <li>
                    {a.href ? <a href={a.href} download>{a.name}</a> : <span>{a.name}</span>}
                    {a.size && <span class="size">{a.size}</span>}
                    {a.sha256 && <span class="hash">sha256:{a.sha256.slice(0, 10)}…</span>}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </article>

      {
        tocGroups.length > 0 && (
          <SmallToc title="文章目录" groups={tocGroups} />
        )
      }
    </div>

    {
      (prev || next) && (
        <nav class="pager" aria-label="上下篇">
          {next ? (
            <a href={`/writeups/${next.id}/`}>
              <span class="k">← 更早</span>
              <span class="t">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {prev ? (
            <a class="next" href={`/writeups/${prev.id}/`}>
              <span class="k">更新 →</span>
              <span class="t">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="section">
          <div class="section-head">
            <h2>相关文章</h2>
          </div>
          <div class="post-list">
            {related.map((p) => (
              <a class="card" href={`/writeups/${p.id}/`}>
                <div class="card-top">
                  <span class="badge" data-cat={p.data.category}>
                    {p.data.category}
                  </span>
                  {p.data.event && <span class="badge">{p.data.event}</span>}
                </div>
                <h3>{p.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <p class="search-hint" style="margin:34px 0 0">
      最后更新：{formatDateCN(data.updatedAt ?? data.publishedAt)} · 内容仅供学习交流
    </p>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const article = document.getElementById('article');
    if (!article) return;

    /* ---------- 首词点题：第一段第一个词标红略放大 ---------- */
    (function markLedeWord() {
      const firstP = Array.prototype.find.call(article.children, function (el) {
        return el.tagName === 'P';
      });
      if (!firstP) return;

      const walker = document.createTreeWalker(firstP, NodeFilter.SHOW_TEXT);
      let node = walker.nextNode();
      while (node && !node.nodeValue.trim()) node = walker.nextNode();
      if (!node) return;

      const raw = node.nodeValue;
      const lead = raw.length - raw.replace(/^\s+/, '').length;
      const rest = raw.slice(lead);
      if (!rest) return;

      let len = 0;
      try {
        if (window.Intl && Intl.Segmenter) {
          const words = [];
          for (const s of new Intl.Segmenter('zh', { granularity: 'word' }).segment(rest)) {
            if (s.isWordLike) words.push(s.segment);
          }
          let word = words[0] || '';
          /* “这 / 一周”“第 / 一次”这类被切碎的词，往后并一格再标 */
          if (word.length === 1 && words[1] && word.length + words[1].length <= 4) {
            word += words[1];
          } else if (/^第[一二三四五六七八九十百千0-9]+$/.test(word) && words[1] && words[1].length <= 2) {
            word += words[1];
          }
          len = word.length;
        }
      } catch (e) {}
      if (!len) {
        const m = rest.match(/^[\p{L}\p{N}_]+/u);
        len = m ? m[0].length : Math.min(2, rest.length);
      }
      if (!len) return;

      const range = document.createRange();
      range.setStart(node, lead);
      range.setEnd(node, lead + len);

      const span = document.createElement('span');
      span.className = 'lede-word';
      try {
        range.surroundContents(span);
      } catch (e) {}
    })();

    /* ---------- 代码块复制 ---------- */
    article.querySelectorAll('pre').forEach(function (pre) {
      if (pre.closest('.flag-box')) return;
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = 'copy';
      btn.addEventListener('click', function () {
        const code = pre.querySelector('code');
        const text = code ? code.textContent || '' : pre.textContent || '';
        const done = function () {
          btn.textContent = 'copied';
          setTimeout(function () {
            btn.textContent = 'copy';
          }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(fallback);
        } else {
          fallback();
        }
        function fallback() {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
            done();
          } catch (e) {}
          document.body.removeChild(ta);
        }
      });
      pre.appendChild(btn);
    });

    /* ---------- Flag 折叠 ---------- */
    article.querySelectorAll('.flag-box').forEach(function (box) {
      const value = box.dataset.flag || '';
      const code = box.querySelector('.flag-value');
      const toggle = box.querySelector('[data-act="toggle"]');
      const copy = box.querySelector('[data-act="copy"]');

      function setRevealed(on) {
        code.textContent = on ? value : '•'.repeat(Math.min(Math.max(value.length, 8), 24));
        code.dataset.revealed = on ? 'true' : 'false';
        toggle.textContent = on ? '隐藏' : '显示';
      }

      if (toggle) {
        toggle.addEventListener('click', function () {
          setRevealed(code.dataset.revealed !== 'true');
        });
      }
      if (copy) {
        copy.addEventListener('click', function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(function () {
              copy.textContent = '已复制';
              setTimeout(function () {
                copy.textContent = '复制';
              }, 1400);
            });
          }
        });
      }
    });

    /* ---------- 图片灯箱 ---------- */
    const lightbox = document.createElement('div');
    lightbox.className = 'lightbox';
    const bigImg = document.createElement('img');
    lightbox.appendChild(bigImg);
    lightbox.addEventListener('click', function () {
      lightbox.classList.remove('is-open');
    });
    document.body.appendChild(lightbox);

    article.querySelectorAll('img').forEach(function (img) {
      img.addEventListener('click', function () {
        bigImg.src = img.src;
        lightbox.classList.add('is-open');
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') lightbox.classList.remove('is-open');
    });

    /* ---------- 阅读进度条 ---------- */
    const bar = document.getElementById('reading-progress');
    if (bar) {
      const update = function () {
        const el = document.documentElement;
        const max = el.scrollHeight - el.clientHeight;
        bar.style.width = (max > 0 ? (el.scrollTop / max) * 100 : 0) + '%';
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    /* ---------- 分享本文 ---------- */
    const shareWrap = document.querySelector('.share-wrap');
    const share = document.getElementById('share-btn');
    const shareMenu = document.getElementById('share-menu');
    const shareStatus = shareMenu && shareMenu.querySelector('.share-status');
    const shareNative = shareMenu && shareMenu.querySelector('[data-share="native"]');

    if (shareWrap && share && shareMenu) {
      const url = location.href.split('?')[0].split('#')[0];
      const title = document.title;
      const text = (document.querySelector('.standfirst') || {}).textContent || '';
      let statusTimer = 0;

      function setStatus(message) {
        if (!shareStatus) return;
        shareStatus.textContent = message;
        clearTimeout(statusTimer);
        statusTimer = setTimeout(function () {
          shareStatus.textContent = '';
        }, 3200);
      }

      function done(message) {
        setStatus(message);
      }

      function fallbackCopy(message) {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        ta.setAttribute('readonly', '');
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          done(message);
        } catch (e) {
          setStatus('复制失败，请手动复制地址栏链接。');
        }
        document.body.removeChild(ta);
      }

      function copyUrl(message) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () {
            done(message);
          }).catch(function () {
            fallbackCopy(message);
          });
        } else {
          fallbackCopy(message);
        }
      }

      function setOpen(open) {
        shareMenu.hidden = !open;
        share.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          const first = shareMenu.querySelector('.share-item:not([hidden])');
          if (first) first.focus({ preventScroll: true });
        }
      }

      share.addEventListener('click', function () {
        setOpen(shareMenu.hidden);
      });

      shareMenu.addEventListener('click', function (e) {
        const item = e.target.closest('.share-item');
        if (!item) return;
        const action = item.getAttribute('data-share');
        if (action === 'copy') {
          copyUrl('链接已复制。');
        } else if (action === 'wechat') {
          copyUrl('链接已复制，打开微信粘贴给好友。');
        } else if (action === 'native') {
          if (navigator.share) {
            navigator.share({ title: title, text: text, url: url }).then(function () {
              setOpen(false);
            }).catch(function (err) {
              if (err && err.name === 'AbortError') return;
              copyUrl('系统分享不可用，链接已复制。');
            });
          } else {
            copyUrl('当前浏览器不支持系统分享，链接已复制。');
          }
        } else if (item.tagName === 'A') {
          setOpen(false);
        }
      });

      if (shareNative && navigator.share) {
        shareNative.hidden = false;
      }

      document.addEventListener('click', function (e) {
        if (!shareMenu.hidden && !shareWrap.contains(e.target)) setOpen(false);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !shareMenu.hidden) {
          setOpen(false);
          share.focus();
        }
      });
    }

  })();
</script>
