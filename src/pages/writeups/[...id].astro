---
import Breadcrumb from '../../components/Breadcrumb.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../consts';
import {
  visiblePosts,
  formatDate,
  formatDateCN,
  readingTime,
  relatedPosts,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('writeups');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;

const all = visiblePosts(await getCollection('writeups'));
const index = all.findIndex((p) => p.id === post.id);
const prev = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
const related = relatedPosts(post, all, 3);

/** 学习目录：列出全部文章，每篇下面收着自己的章节书签 */
const outlines: {
  id: string;
  title: string;
  current: boolean;
  headings: { depth: number; slug: string; text: string }[];
}[] = [];
for (const p of all) {
  const outline =
    p.id === post.id
      ? headings
      : (await render(p)).headings;
  outlines.push({
    id: p.id,
    title: p.data.title,
    current: p.id === post.id,
    headings: outline.filter((h) => h.depth === 2 || h.depth === 3),
  });
}
const minutes = readingTime(post.body);
const description = data.summary;

const siteUrl = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;

/** JSON 里的 `<` 转义成 \u003c，正文出现 </script> 也不会顶断结构化数据标签 */
const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');

/** 文章级结构化数据：搜索引擎与分享卡片能读到标题、日期、分类、标签 */
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.summary,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  inLanguage: 'zh-CN',
  articleSection: data.category,
  keywords: data.tags.join(', '),
  author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  publisher: { '@type': 'Organization', name: SITE.title, url: siteUrl.href },
};
---

<BaseLayout title={data.title} description={description} type="article" publishedAt={data.publishedAt}>
  <script slot="head" type="application/ld+json" set:html={jsonLd(articleSchema)} />
  <script is:inline slot="head">
    /* 目录收起状态在首屏绘制前就恢复，避免展开再收起的闪动 */
    try {
      var narrow = window.matchMedia('(max-width: 1040px)').matches;
      document.documentElement.setAttribute(
        'data-toc',
        narrow ? 'off' : localStorage.getItem('shaloworld-toc') === 'off' ? 'off' : 'open'
      );
    } catch (e) {}
  </script>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <div class="wrap">
    <section class="article-top">
      <Breadcrumb
        segments={[{ label: 'learning', href: '/writeups/' }, ...(data.event ? [{ label: data.event }] : []), { label: data.category, cat: data.category }]}
      />

      <div class="article-badges">
        <span class="badge" data-cat={data.category}>{data.category}</span>
        {data.difficulty && <span class="badge" data-diff={data.difficulty}>{data.difficulty}</span>}
        {data.event && <span class="badge">{data.event}</span>}
      </div>

      <h1>{data.title}</h1>

      <p class="standfirst">{data.summary}</p>

      <div class="article-meta">
        <span>发布于 {formatDate(data.publishedAt)}</span>
        {data.updatedAt && <span>更新 {formatDate(data.updatedAt)}</span>}
        <span>{minutes} min 阅读</span>
        {data.solveTime && <span>解题 {data.solveTime}</span>}
        {data.tools.length > 0 && <span>工具 {data.tools.join(' / ')}</span>}
        <button class="share-btn" id="share-btn" type="button">复制链接</button>
      </div>
    </section>

    <div class="article-grid">
      <article class="prose" id="article">
        <Content />

        {
          data.attachments.length > 0 && (
            <div class="attachments">
              <div class="attachments-head">附件 / attachments</div>
              <ul>
                {data.attachments.map((a) => (
                  <li>
                    {a.href ? <a href={a.href} download>{a.name}</a> : <span>{a.name}</span>}
                    {a.size && <span class="size">{a.size}</span>}
                    {a.sha256 && <span class="hash">sha256:{a.sha256.slice(0, 10)}…</span>}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </article>

      {
        outlines.length > 0 && (
          <>
            <aside class="toc" id="toc" aria-label="学习目录">
              <div class="toc-head">
                <span class="toc-title">学习目录</span>
                <button class="toc-collapse" id="toc-collapse" type="button" aria-label="收起目录" aria-expanded="true">
                  收起
                </button>
              </div>
              <ul class="toc-list">
                {outlines.map((o, oi) => (
                  <li class="toc-post" data-current={o.current ? 'true' : 'false'}>
                    {o.headings.length > 0 ? (
                      <a
                        class="toc-h2 has-sub"
                        href={o.current ? '#top' : `/writeups/${o.id}/`}
                        data-sub={`post-${oi}`}
                        aria-expanded="false"
                      >
                        <span class="toc-text">{o.title}</span>
                        <span class="toc-caret" aria-hidden="true">
                          ›
                        </span>
                      </a>
                    ) : (
                      <a class="toc-h2" href={o.current ? '#top' : `/writeups/${o.id}/`}>
                        <span class="toc-text">{o.title}</span>
                      </a>
                    )}
                    {o.headings.length > 0 && (
                      <ul class="toc-sub" id={`toc-sub-post-${oi}`} hidden>
                        {o.headings.map((h) => (
                          <li class={h.depth === 3 ? 'is-deep' : ''}>
                            <a href={o.current ? `#${h.slug}` : `/writeups/${o.id}/#${h.slug}`}>{h.text}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </aside>
          </>
        )
      }
    </div>

    {
      (prev || next) && (
        <nav class="pager" aria-label="上下篇">
          {next ? (
            <a href={`/writeups/${next.id}/`}>
              <span class="k">← 更早</span>
              <span class="t">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {prev ? (
            <a class="next" href={`/writeups/${prev.id}/`}>
              <span class="k">更新 →</span>
              <span class="t">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="section">
          <div class="section-head">
            <h2>相关学习</h2>
          </div>
          <div class="post-list">
            {related.map((p) => (
              <a class="card" href={`/writeups/${p.id}/`}>
                <div class="card-top">
                  <span class="badge" data-cat={p.data.category}>
                    {p.data.category}
                  </span>
                  {p.data.event && <span class="badge">{p.data.event}</span>}
                </div>
                <h3>{p.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <p class="search-hint" style="margin:34px 0 0">
      最后更新：{formatDateCN(data.updatedAt ?? data.publishedAt)} · 内容仅供学习交流
    </p>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const article = document.getElementById('article');
    if (!article) return;

    /* ---------- 首词点题：第一段第一个词标红略放大 ---------- */
    (function markLedeWord() {
      const firstP = Array.prototype.find.call(article.children, function (el) {
        return el.tagName === 'P';
      });
      if (!firstP) return;

      const walker = document.createTreeWalker(firstP, NodeFilter.SHOW_TEXT);
      let node = walker.nextNode();
      while (node && !node.nodeValue.trim()) node = walker.nextNode();
      if (!node) return;

      const raw = node.nodeValue;
      const lead = raw.length - raw.replace(/^\s+/, '').length;
      const rest = raw.slice(lead);
      if (!rest) return;

      let len = 0;
      try {
        if (window.Intl && Intl.Segmenter) {
          const words = [];
          for (const s of new Intl.Segmenter('zh', { granularity: 'word' }).segment(rest)) {
            if (s.isWordLike) words.push(s.segment);
          }
          let word = words[0] || '';
          /* “这 / 一周”“第 / 一次”这类被切碎的词，往后并一格再标 */
          if (word.length === 1 && words[1] && word.length + words[1].length <= 4) {
            word += words[1];
          } else if (/^第[一二三四五六七八九十百千0-9]+$/.test(word) && words[1] && words[1].length <= 2) {
            word += words[1];
          }
          len = word.length;
        }
      } catch (e) {}
      if (!len) {
        const m = rest.match(/^[\p{L}\p{N}_]+/u);
        len = m ? m[0].length : Math.min(2, rest.length);
      }
      if (!len) return;

      const range = document.createRange();
      range.setStart(node, lead);
      range.setEnd(node, lead + len);

      const span = document.createElement('span');
      span.className = 'lede-word';
      try {
        range.surroundContents(span);
      } catch (e) {}
    })();

    /* ---------- 代码块复制 ---------- */
    article.querySelectorAll('pre').forEach(function (pre) {
      if (pre.closest('.flag-box')) return;
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = 'copy';
      btn.addEventListener('click', function () {
        const code = pre.querySelector('code');
        const text = code ? code.textContent || '' : pre.textContent || '';
        const done = function () {
          btn.textContent = 'copied';
          setTimeout(function () {
            btn.textContent = 'copy';
          }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(fallback);
        } else {
          fallback();
        }
        function fallback() {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
            done();
          } catch (e) {}
          document.body.removeChild(ta);
        }
      });
      pre.appendChild(btn);
    });

    /* ---------- Flag 折叠 ---------- */
    article.querySelectorAll('.flag-box').forEach(function (box) {
      const value = box.dataset.flag || '';
      const code = box.querySelector('.flag-value');
      const toggle = box.querySelector('[data-act="toggle"]');
      const copy = box.querySelector('[data-act="copy"]');

      function setRevealed(on) {
        code.textContent = on ? value : '•'.repeat(Math.min(Math.max(value.length, 8), 24));
        code.dataset.revealed = on ? 'true' : 'false';
        toggle.textContent = on ? '隐藏' : '显示';
      }

      if (toggle) {
        toggle.addEventListener('click', function () {
          setRevealed(code.dataset.revealed !== 'true');
        });
      }
      if (copy) {
        copy.addEventListener('click', function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(function () {
              copy.textContent = '已复制';
              setTimeout(function () {
                copy.textContent = '复制';
              }, 1400);
            });
          }
        });
      }
    });

    /* ---------- 图片灯箱 ---------- */
    const lightbox = document.createElement('div');
    lightbox.className = 'lightbox';
    const bigImg = document.createElement('img');
    lightbox.appendChild(bigImg);
    lightbox.addEventListener('click', function () {
      lightbox.classList.remove('is-open');
    });
    document.body.appendChild(lightbox);

    article.querySelectorAll('img').forEach(function (img) {
      img.addEventListener('click', function () {
        bigImg.src = img.src;
        lightbox.classList.add('is-open');
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') lightbox.classList.remove('is-open');
    });

    /* ---------- 阅读进度条 ---------- */
    const bar = document.getElementById('reading-progress');
    if (bar) {
      const update = function () {
        const el = document.documentElement;
        const max = el.scrollHeight - el.clientHeight;
        bar.style.width = (max > 0 ? (el.scrollTop / max) * 100 : 0) + '%';
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    /* ---------- 复制本文链接 ---------- */
    const share = document.getElementById('share-btn');
    if (share) {
      share.addEventListener('click', function () {
        const url = location.href.split('?')[0].split('#')[0];
        function done() {
          share.textContent = '已复制';
          setTimeout(function () {
            share.textContent = '复制链接';
          }, 1400);
        }
        function fallback() {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
            done();
          } catch (e) {}
          document.body.removeChild(ta);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(fallback);
        } else {
          fallback();
        }
      });
    }

    /* ---------- 目录：页头按钮开小目录 / 展开小节 / 收起整栏 ---------- */
    const collapseBtn = document.getElementById('toc-collapse');
    const tocEntry = document.getElementById('toc-entry');
    const tocPanel = document.getElementById('toc');

    function setTocOpen(open, persist) {
      document.documentElement.setAttribute('data-toc', open ? 'open' : 'off');
      if (collapseBtn) collapseBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (persist === false) return;
      try {
        localStorage.setItem('shaloworld-toc', open ? 'open' : 'off');
      } catch (e) {}
    }
    if (collapseBtn) {
      setTocOpen(document.documentElement.getAttribute('data-toc') !== 'off', false);
    }

    /* 页头「目录」：单击开小目录，双击去目录总页；鼠标移出小目录就收回 */
    function setPop(on) {
      document.documentElement.setAttribute('data-pop', on ? 'on' : 'off');
      if (tocEntry) tocEntry.setAttribute('aria-expanded', on ? 'true' : 'false');
    }
    const popOpen = function () {
      return document.documentElement.getAttribute('data-pop') === 'on';
    };
    let popTimer = null;
    function holdPop() {
      if (popTimer) clearTimeout(popTimer);
      popTimer = null;
    }
    function dropPop(delay) {
      holdPop();
      popTimer = setTimeout(function () {
        setPop(false);
      }, delay || 260);
    }

    if (tocEntry) {
      tocEntry.addEventListener('click', function (e) {
        e.preventDefault();
        if (e.detail > 1) return; /* 双击时第二下不来回开合，交给 dblclick 去跳转 */
        setPop(!popOpen());
      });
      tocEntry.addEventListener('dblclick', function () {
        window.location.href = '/toc/';
      });
      tocEntry.addEventListener('mouseenter', holdPop);
      tocEntry.addEventListener('mouseleave', function () {
        if (popOpen()) dropPop(320);
      });
    }
    if (tocPanel) {
      tocPanel.addEventListener('mouseenter', holdPop);
      tocPanel.addEventListener('mouseleave', function () {
        if (popOpen()) dropPop(240);
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setPop(false);
    });

    /* 小目录里的「收起」：浮层状态下关浮层，侧栏状态下收侧栏 */
    if (collapseBtn) {
      collapseBtn.addEventListener('click', function () {
        if (popOpen()) {
          setPop(false);
          return;
        }
        setTocOpen(false);
      });
    }

    function setGroup(link, open) {
      const sub = document.getElementById('toc-sub-' + link.getAttribute('data-sub'));
      if (!sub) return;
      link.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) sub.removeAttribute('hidden');
      else sub.setAttribute('hidden', '');
    }

    function jumpTo(hash) {
      if (!hash) return;
      const el = document.getElementById(decodeURIComponent(hash.slice(1)));
      if (!el) return;
      if (history.pushState) history.pushState(null, '', hash);
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function go(href) {
      if (!href) return;
      if (href.charAt(0) === '#') jumpTo(href);
      else window.location.href = href;
    }

    let pendingClick = null;
    document.querySelectorAll('#toc .has-sub').forEach(function (link) {
      /* 单击：展开 / 收起这篇文章的章节书签 */
      link.addEventListener('click', function (e) {
        e.preventDefault();
        if (pendingClick) clearTimeout(pendingClick);
        pendingClick = setTimeout(function () {
          pendingClick = null;
          setGroup(link, link.getAttribute('aria-expanded') !== 'true');
        }, 220);
      });
      /* 双击：文章名 → 打开这篇文章；章节 → 跳到对应内容 */
      link.addEventListener('dblclick', function (e) {
        e.preventDefault();
        if (pendingClick) {
          clearTimeout(pendingClick);
          pendingClick = null;
        }
        go(link.getAttribute('href'));
      });
      /* 键盘：Enter / 空格 直接跳转 */
      link.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        if (pendingClick) {
          clearTimeout(pendingClick);
          pendingClick = null;
        }
        go(link.getAttribute('href'));
      });
    });

    /* 当前这篇默认展开，读者一眼看到自己的章节 */
    const currentPost = document.querySelector('.toc-post[data-current="true"]');
    const currentToggle = currentPost && currentPost.querySelector('.has-sub');
    if (currentToggle) setGroup(currentToggle, true);

    /* ---------- 目录滚动高亮（只跟踪当前文章） ---------- */
    const tocLinks = currentPost ? Array.from(currentPost.querySelectorAll('.toc-sub a')) : [];
    if (!tocLinks.length) return;

    const targets = tocLinks
      .map(function (a) {
        const el = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
        return el ? { link: a, el: el } : null;
      })
      .filter(Boolean);

    function onScroll() {
      let current = targets[0];
      targets.forEach(function (t) {
        if (t.el.getBoundingClientRect().top <= 130) current = t;
      });
      tocLinks.forEach(function (a) {
        a.classList.remove('active');
      });
      if (!current) return;
      current.link.classList.add('active');

      /* 滚到某一节时，若这篇文章的书签被手动收起了，就顺手展开 */
      const sub = current.link.closest('.toc-sub');
      if (sub && sub.hasAttribute('hidden')) {
        const toggle = sub.parentElement.querySelector('.has-sub');
        if (toggle) setGroup(toggle, true);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
