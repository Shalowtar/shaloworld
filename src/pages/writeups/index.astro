---
import Breadcrumb from '../../components/Breadcrumb.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmallToc from '../../components/SmallToc.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { visiblePosts, categoryCounts } from '../../utils/posts';
import { CATEGORIES } from '../../consts';
import type { TocGroup } from '../../utils/toc';

const all = visiblePosts(await getCollection('writeups'));
const counts = categoryCounts(all, CATEGORIES);
const tocGroups: TocGroup[] = counts.map((c) => ({
  name: c.name,
  href: `/writeups/?cat=${encodeURIComponent(c.name)}`,
  meta: `${c.count}`,
}));
---

<BaseLayout title="学习" description="把学过的整理在这里：按分类筛选、按时间倒序。">
  <div class="wrap">
    <section class="article-top">
      <Breadcrumb segments={[{ label: 'learning' }]} />
      <h1>学习</h1>
      <div class="article-meta">
        <span>共 {all.length} 篇</span>
        <span>按时间倒序</span>
      </div>
    </section>

    <div class="article-grid">
      <div class="page-main">
        {
          all.length > 0 && (
            <div class="filters" id="filters">
              <button class="chip" data-filter="all" aria-pressed="true">全部 ({all.length})</button>
              {counts.map((c) => (
                <button class="chip" data-filter={c.name} aria-pressed="false">
                  <span class="cat-tone" data-cat={c.name}>{c.name}</span> ({c.count})
                </button>
              ))}
            </div>
          )
        }

        {
          all.length > 0 && (
            <div class="post-list" id="post-list">
              {all.map((post) => (
                <div class="post-item" data-cat={post.data.category} data-event={post.data.event ?? ''}>
                  <PostCard post={post} />
                </div>
              ))}
            </div>
          )
        }

        <p class="search-hint" id="filter-count" style="margin-top:22px"></p>
      </div>

      {tocGroups.length > 0 && <SmallToc title="学习目录" groups={tocGroups} />}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll('#filters .chip');
    const items = Array.from(document.querySelectorAll('.post-item'));
    const counter = document.getElementById('filter-count');
    if (!buttons.length || !items.length) return;

    function apply(filter, event) {
      event = event || '';
      let shown = 0;
      items.forEach(function (item) {
        const match =
          (filter === 'all' || item.dataset.cat === filter) &&
          (!event || item.dataset.event === event);
        item.hidden = !match;
        if (match) shown += 1;
      });
      buttons.forEach(function (b) {
        const active =
          b.dataset.filter === filter && (filter !== 'all' || !event);
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (counter) counter.textContent = '> 匹配 ' + shown + ' 篇';
      const params = new URLSearchParams();
      if (filter !== 'all') params.set('cat', filter);
      if (event) params.set('event', event);
      const url = params.toString() ? location.pathname + '?' + params.toString() : location.pathname;
      history.replaceState(null, '', url);
    }

    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        apply(b.dataset.filter, '');
      });
    });

    const params = new URLSearchParams(location.search);
    const preset = params.get('cat');
    const presetEvent = params.get('event') || '';
    const known = Array.prototype.some.call(buttons, function (b) {
      return b.dataset.filter === preset;
    });
    apply(known ? preset : 'all', presetEvent);
  })();
</script>
